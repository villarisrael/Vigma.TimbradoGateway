@page "{id:long}"
@model Vigma.TimbradoGateway.Pages.Monitor.Clientes.DetallesModel
@{
    ViewData["Title"] = $"Detalles — {Model.Nombre}";
    var pctError = (Model.TotalTimbrados + Model.TotalErrores) > 0
        ? (double)Model.TotalErrores / (Model.TotalTimbrados + Model.TotalErrores) * 100
        : 0;
}

<link href="~/css/Gstyle.css" rel="stylesheet" />

<style>
.dt-page { padding: var(--space-5); max-width: var(--container-xxl); }

/* Hero */
.dt-hero {
    border-radius: var(--radius-xl); padding: var(--space-5);
    margin-bottom: var(--space-5); box-shadow: var(--shadow-lg);
    display: flex; align-items: center; gap: var(--space-5);
    flex-wrap: wrap;
    background: var(--vigma-gradient);
}

.dt-hero-avatar {
    width: 80px; height: 80px; border-radius: var(--radius-lg);
    background: rgba(255,255,255,0.2); border: 2px solid rgba(255,255,255,0.3);
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-titles); font-weight: var(--weight-bold);
    font-size: var(--text-4xl); color: white; flex-shrink: 0; overflow: hidden;
}

.dt-hero-avatar img { width: 100%; height: 100%; object-fit: contain; padding: 6px; background: white; }

.dt-hero-info { flex: 1; min-width: 0; }

.dt-hero-name {
    font-family: var(--font-titles); font-weight: var(--weight-bold);
    font-size: var(--text-3xl); color: white; line-height: 1.1; margin-bottom: var(--space-2);
}

.dt-hero-rfc {
    font-size: var(--text-sm); color: rgba(255,255,255,0.75);
    margin-bottom: var(--space-3);
}

.dt-hero-badges { display: flex; gap: var(--space-2); flex-wrap: wrap; }

.dt-hero-badge {
    display: inline-flex; align-items: center; gap: var(--space-1);
    background: rgba(255,255,255,0.15); color: white;
    font-size: var(--text-xs); font-weight: var(--weight-semibold);
    padding: var(--space-1) var(--space-3); border-radius: var(--radius-full);
    backdrop-filter: blur(4px);
}

.dt-hero-badge.active-badge  { background: rgba(56,239,125,0.3); }
.dt-hero-badge.suspend-badge { background: rgba(255,255,255,0.12); }

.dt-hero-actions { display: flex; gap: var(--space-3); flex-shrink: 0; flex-wrap: wrap; }

/* Stat cards */
.dt-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-4); margin-bottom: var(--space-5); }

@@media (max-width: 900px) { .dt-stats { grid-template-columns: repeat(2, 1fr); } }
@@media (max-width: 540px) { .dt-stats { grid-template-columns: 1fr; } }

.dt-stat-card {
    background: var(--bg-light-card); border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md); border: 1px solid rgba(0,0,0,0.04);
    padding: var(--space-5); display: flex; flex-direction: column; gap: var(--space-2);
}

[data-theme="dark"] .dt-stat-card { background: var(--bg-dark-card); border-color: rgba(255,255,255,0.05); }

.dt-stat-label {
    font-size: var(--text-xs); font-weight: var(--weight-semibold);
    color: #9090b0; text-transform: uppercase; letter-spacing: 0.5px;
    display: flex; align-items: center; gap: var(--space-2);
}

.dt-stat-value {
    font-family: var(--font-titles); font-weight: var(--weight-bold);
    font-size: var(--text-3xl); color: var(--color-dark); line-height: 1;
}

[data-theme="dark"] .dt-stat-value { color: #e0e0f0; }

.dt-stat-value.success { color: var(--color-success); }
.dt-stat-value.danger  { color: var(--color-danger);  }
.dt-stat-value.vigma   { color: var(--color-vigma);   }
.dt-stat-value.warning { color: var(--color-warning); }

/* Info card */
.dt-info-card {
    background: var(--bg-light-card); border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md); border: 1px solid rgba(0,0,0,0.04);
    overflow: hidden; margin-bottom: var(--space-5);
}

[data-theme="dark"] .dt-info-card { background: var(--bg-dark-card); border-color: rgba(255,255,255,0.05); }

.dt-info-header {
    display: flex; align-items: center; gap: var(--space-2);
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--bg-light-muted);
    background: var(--bg-light-subtle);
    font-family: var(--font-titles); font-weight: var(--weight-semibold);
    font-size: var(--text-base); color: var(--color-dark);
}

[data-theme="dark"] .dt-info-header { border-color: var(--bg-dark-muted); background: var(--bg-dark-subtle); color: #e0e0f0; }

.dt-info-body { padding: var(--space-5); }

/* Table */
.dt-table-card {
    background: var(--bg-light-card); border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md); border: 1px solid rgba(0,0,0,0.04); overflow: hidden;
}

[data-theme="dark"] .dt-table-card { background: var(--bg-dark-card); border-color: rgba(255,255,255,0.05); }

.dt-table-header {
    display: flex; justify-content: space-between; align-items: center;
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--bg-light-muted);
}

[data-theme="dark"] .dt-table-header { border-color: var(--bg-dark-muted); }

.dt-table-header-title {
    display: flex; align-items: center; gap: var(--space-2);
    font-family: var(--font-titles); font-weight: var(--weight-semibold);
    font-size: var(--text-base); color: var(--color-dark);
}

[data-theme="dark"] .dt-table-header-title { color: #e0e0f0; }

.dt-table-wrapper { overflow-x: auto; }

.dt-table { width: 100%; border-collapse: collapse; min-width: 600px; }

.dt-table thead tr { background: var(--bg-light-subtle); }
[data-theme="dark"] .dt-table thead tr { background: var(--bg-dark-subtle); }

.dt-table th {
    padding: var(--space-3) var(--space-4); text-align: left;
    font-size: var(--text-xs); font-weight: var(--weight-semibold);
    color: #9090b0; text-transform: uppercase; letter-spacing: 0.5px; white-space: nowrap;
}

.dt-table td {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--bg-light-muted);
    font-size: var(--text-sm); color: var(--color-dark); vertical-align: middle;
}

[data-theme="dark"] .dt-table td { border-color: var(--bg-dark-muted); color: #c0c0d8; }

.dt-table tbody tr { transition: var(--transition-fast); }
.dt-table tbody tr:hover { background: var(--bg-light-subtle); }
[data-theme="dark"] .dt-table tbody tr:hover { background: var(--bg-dark-subtle); }

/* Tenant cell */
.dt-tn-cell { display: flex; align-items: center; gap: var(--space-3); }

.dt-avatar {
    width: 34px; height: 34px; border-radius: var(--radius-sm);
    background: linear-gradient(135deg, rgba(91,91,214,0.12), rgba(139,47,201,0.12));
    display: flex; align-items: center; justify-content: center;
    font-size: var(--text-sm); font-weight: var(--weight-bold); color: var(--color-vigma); flex-shrink: 0;
}

.dt-status {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 3px var(--space-2); border-radius: var(--radius-full);
    font-size: var(--text-xs); font-weight: var(--weight-semibold);
}

.dt-status-on  { background: rgba(17,153,142,0.1);  color: #11998e; }
.dt-status-off { background: var(--bg-light-subtle); color: #9090b0; border: 1px solid var(--bg-light-muted); }
[data-theme="dark"] .dt-status-off { background: var(--bg-dark-subtle); border-color: var(--bg-dark-muted); }

.dt-num { font-family: var(--font-titles); font-weight: var(--weight-semibold); }

.dt-empty {
    display: flex; flex-direction: column; align-items: center;
    justify-content: center; gap: var(--space-4);
    padding: var(--space-8) var(--space-5); text-align: center;
}

.dt-empty-icon {
    width: 80px; height: 80px; border-radius: var(--radius-full);
    background: var(--bg-light-subtle);
    display: flex; align-items: center; justify-content: center;
    font-size: var(--text-3xl);
}

[data-theme="dark"] .dt-empty-icon { background: var(--bg-dark-subtle); }

.dt-empty-text { font-size: var(--text-sm); color: #9090b0; }
</style>

<div class="main-content">
    <div class="dt-page">

        <!-- Hero -->
        <div class="dt-hero">
            <div class="dt-hero-avatar">
                @if (!string.IsNullOrWhiteSpace(Model.LogoPath))
                {
                    <img src="@Model.LogoPath?v=@Model.ClienteId" alt="@Model.Nombre" />
                }
                else
                {
                    @Model.Nombre.Substring(0, 1).ToUpper()
                }
            </div>

            <div class="dt-hero-info">
                <div class="dt-hero-name">@Model.Nombre</div>
                @if (!string.IsNullOrWhiteSpace(Model.Rfc))
                {
                    <div class="dt-hero-rfc">
                        <i class="bi bi-file-earmark-text"></i> RFC: @Model.Rfc
                    </div>
                }
                <div class="dt-hero-badges">
                    @if (Model.Activo)
                    {
                        <span class="dt-hero-badge active-badge">
                            <i class="bi bi-circle-fill" style="font-size:7px"></i> Activo
                        </span>
                    }
                    else
                    {
                        <span class="dt-hero-badge suspend-badge">
                            <i class="bi bi-circle" style="font-size:7px"></i> Suspendido
                        </span>
                    }
                    <span class="dt-hero-badge">
                        <i class="bi bi-calendar3"></i>
                        Creado @Model.CreadoUtc.ToLocalTime().ToString("dd/MM/yyyy")
                    </span>
                    <span class="dt-hero-badge">
                        <i class="bi bi-hdd-stack-fill"></i>
                        @Model.TotalTenants tenants
                    </span>
                    <span class="dt-hero-badge">
                        <i class="bi bi-people-fill"></i>
                        @Model.UsuariosCliente.Count usuarios
                    </span>
                </div>
            </div>

            <div class="dt-hero-actions">
                <a asp-page="Editar" asp-route-id="@Model.ClienteId"
                   class="vg-btn"
                   style="background:white; color:var(--color-vigma); font-weight:var(--weight-semibold);">
                    <i class="bi bi-pencil-fill"></i> Editar
                </a>
                <a asp-page="Index"
                   class="vg-btn"
                   style="background:rgba(255,255,255,0.15); color:white; border:1.5px solid rgba(255,255,255,0.3);">
                    <i class="bi bi-arrow-left"></i> Volver
                </a>
            </div>
        </div>

        <!-- Stats -->
        <div class="dt-stats">
            <div class="dt-stat-card">
                <div class="dt-stat-label">
                    <i class="bi bi-hdd-stack-fill"></i> Total Tenants
                </div>
                <div class="dt-stat-value vigma">@Model.TotalTenants</div>
                <div style="font-size:var(--text-xs); color:#9090b0;">
                    @Model.TenantsActivos activos / @(Model.TotalTenants - Model.TenantsActivos) inactivos
                </div>
            </div>

            <div class="dt-stat-card">
                <div class="dt-stat-label">
                    <i class="bi bi-file-earmark-check-fill"></i> Timbrados
                </div>
                <div class="dt-stat-value success">@Model.TotalTimbrados.ToString("N0")</div>
                <div style="font-size:var(--text-xs); color:#9090b0;">Total histórico</div>
            </div>

            <div class="dt-stat-card">
                <div class="dt-stat-label">
                    <i class="bi bi-exclamation-triangle-fill"></i> Errores
                </div>
                <div class="dt-stat-value danger">@Model.TotalErrores.ToString("N0")</div>
                <div style="font-size:var(--text-xs); color:#9090b0;">Total histórico</div>
            </div>

            <div class="dt-stat-card">
                <div class="dt-stat-label">
                    <i class="bi bi-percent"></i> % Error
                </div>
                <div class="dt-stat-value @(pctError > 10 ? "danger" : pctError > 5 ? "warning" : "success")">
                    @pctError.ToString("F1")%
                </div>
                <div style="font-size:var(--text-xs); color:#9090b0;">Sobre el total de operaciones</div>
            </div>
        </div>

        <!-- Tabla de tenants -->
        <div class="dt-table-card">
            <div class="dt-table-header">
                <div class="dt-table-header-title">
                    <i class="bi bi-hdd-stack-fill" style="color:var(--color-vigma)"></i>
                    Tenants de @Model.Nombre
                </div>
                <a asp-page="Editar" asp-route-id="@Model.ClienteId"
                   class="vg-btn vg-btn-outline" style="font-size:var(--text-xs);">
                    <i class="bi bi-gear-fill"></i> Gestionar tenants
                </a>
            </div>

            @if (!Model.Tenants.Any())
            {
                <div class="dt-empty">
                    <div class="dt-empty-icon"><i class="bi bi-hdd-stack"></i></div>
                    <div class="dt-empty-text">
                        Este cliente no tiene tenants asignados.<br />
                        <a asp-page="Editar" asp-route-id="@Model.ClienteId">Asignar tenants</a>
                    </div>
                </div>
            }
            else
            {
                <div class="dt-table-wrapper">
                    <table class="dt-table">
                        <thead>
                            <tr>
                                <th>Tenant</th>
                                <th>Estado</th>
                                <th style="text-align:right">Timbrados</th>
                                <th style="text-align:right">Errores</th>
                                <th style="text-align:right">% Error</th>
                                <th style="text-align:center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in Model.Tenants)
                            {
                                var total  = t.Timbrados + t.Errores;
                                var errPct = total > 0 ? (double)t.Errores / total * 100 : 0;

                                <tr>
                                    <!-- Tenant -->
                                    <td>
                                        <div class="dt-tn-cell">
                                            <div class="dt-avatar">
                                                @t.Nombre.Substring(0, 1).ToUpper()
                                            </div>
                                            <span style="font-weight:var(--weight-medium);">@t.Nombre</span>
                                        </div>
                                    </td>

                                    <!-- Estado -->
                                    <td>
                                        @if (t.Activo)
                                        {
                                            <span class="dt-status dt-status-on">
                                                <i class="bi bi-circle-fill" style="font-size:7px"></i> Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="dt-status dt-status-off">
                                                <i class="bi bi-circle" style="font-size:7px"></i> Inactivo
                                            </span>
                                        }
                                    </td>

                                    <!-- Timbrados -->
                                    <td style="text-align:right">
                                        <span class="dt-num" style="color:var(--color-success)">
                                            @t.Timbrados.ToString("N0")
                                        </span>
                                    </td>

                                    <!-- Errores -->
                                    <td style="text-align:right">
                                        <span class="dt-num" style="color:@(t.Errores > 0 ? "var(--color-danger)" : "#9090b0")">
                                            @t.Errores.ToString("N0")
                                        </span>
                                    </td>

                                    <!-- % Error -->
                                    <td style="text-align:right">
                                        <span style="font-size:var(--text-xs); font-weight:var(--weight-semibold);
                                                     color:@(errPct > 10 ? "var(--color-danger)" : errPct > 5 ? "var(--color-warning)" : "var(--color-success)")">
                                            @errPct.ToString("F1")%
                                        </span>
                                    </td>

                                    <!-- Acciones -->
                                    <td style="text-align:center">
                                        <a href="/Monitor/Tenants/Detalle/@t.Id"
                                           class="vg-btn vg-btn-outline"
                                           style="font-size:var(--text-xs); padding:4px 10px;">
                                            <i class="bi bi-box-arrow-in-right"></i> Ver Tenant
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- Usuarios del cliente -->
        <div class="dt-table-card" style="margin-top: var(--space-5);">
            <div class="dt-table-header">
                <div class="dt-table-header-title">
                    <i class="bi bi-people-fill" style="color:var(--color-vigma)"></i>
                    Usuarios del Cliente
                    <span style="display:inline-flex; align-items:center; justify-content:center;
                                 min-width:22px; height:22px; padding:0 var(--space-2);
                                 background:rgba(91,91,214,0.12); border-radius:var(--radius-full);
                                 font-size:var(--text-xs); font-weight:var(--weight-bold); color:var(--color-vigma);">
                        @Model.UsuariosCliente.Count
                    </span>
                </div>
                <a asp-page="Editar" asp-route-id="@Model.ClienteId"
                   class="vg-btn vg-btn-outline" style="font-size:var(--text-xs);">
                    <i class="bi bi-person-plus-fill"></i> Gestionar usuarios
                </a>
            </div>

            @if (!Model.UsuariosCliente.Any())
            {
                <div class="dt-empty" style="padding: var(--space-6) var(--space-5);">
                    <div class="dt-empty-icon"><i class="bi bi-people"></i></div>
                    <div class="dt-empty-text">
                        Este cliente no tiene usuarios.<br />
                        <a asp-page="Editar" asp-route-id="@Model.ClienteId">Crear usuario</a>
                    </div>
                </div>
            }
            else
            {
                <div class="dt-table-wrapper">
                    <table class="dt-table">
                        <thead>
                            <tr>
                                <th>Email / Usuario</th>
                                <th>Nombre</th>
                                <th>Estado</th>
                                <th>Creado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var u in Model.UsuariosCliente)
                            {
                                <tr>
                                    <td>
                                        <div class="dt-tn-cell">
                                            <div class="dt-avatar" style="background:linear-gradient(135deg,rgba(91,91,214,0.1),rgba(139,47,201,0.1));">
                                                <i class="bi bi-person-fill" style="color:var(--color-vigma);"></i>
                                            </div>
                                            <span style="font-weight:var(--weight-medium);">@u.Usuario</span>
                                        </div>
                                    </td>
                                    <td>@(u.Nombre ?? "—")</td>
                                    <td>
                                        @if (u.Activo)
                                        {
                                            <span class="dt-status dt-status-on">
                                                <i class="bi bi-circle-fill" style="font-size:7px"></i> Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="dt-status dt-status-off">
                                                <i class="bi bi-circle" style="font-size:7px"></i> Inactivo
                                            </span>
                                        }
                                    </td>
                                    <td style="font-size:var(--text-xs); color:#9090b0;">
                                        @u.Creado.ToLocalTime().ToString("dd/MM/yyyy")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

    </div>
</div>
