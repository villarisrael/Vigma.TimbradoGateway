            </div>

            <!-- ░░ API Key FacturaLO ░░ -->
            <div class="tn-attr-section">
                <div class="tn-attr-section-title">
                    <i class="bi bi-key-fill"></i>
                    API Key FacturaLO — ${escHtml(flKeyLabel)}
                </div>

                <div class="tn-attr-row">
                    <div class="tn-attr-label">
                        <i class="bi bi-shield-check"></i> Clave del PAC FacturaLO
                    </div>
                    <div class="tn-attr-field">
                        <div class="tn-attr-value ${!flKey ? 'empty' : ''}" id="val-flkey">
                            ${flKey ? escHtml(flKey) : 'No configurada'}
                        </div>
                        ${flKey ? `
                        <button class="tn-attr-copy" onclick="copiarAttr('val-flkey', this)" title="Copiar API Key FacturaLO">
