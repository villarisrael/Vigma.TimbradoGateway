    /* ═══════════════════════════════════════════════════════════════════
       HELPERS
       ═══════════════════════════════════════════════════════════════════ */

    /** Escapa HTML para inserción en innerHTML */
    function escHtml(str) {
        return String(str ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    /** Escapa para strings JS inline (onclick="...") */
    function escJs(str) {
        return String(str ?? '').replace(/\\/g,'\\\\').replace(/'/g,"\\'");
    }

    /** Copia el texto de un elemento al portapapeles y marca el botón */
    async function copiarAttr(elId, btn) {
        const el  = document.getElementById(elId);
        const val = el ? el.textContent.trim() : '';
        if (!val) return;
        try {
            await navigator.clipboard.writeText(val);
            btn.classList.add('copied');
            btn.querySelector('i').className = 'bi bi-check-lg';
            setTimeout(() => {
                btn.classList.remove('copied');
                btn.querySelector('i').className = 'bi bi-clipboard';
            }, 1600);
        } catch {
            Swal.fire({ icon: 'error', title: 'Error', text: 'No se pudo copiar al portapapeles.', timer: 1800, showConfirmButton: false });
        }
    }

    /* ── Copiar API Key (tabla) — se conserva para compatibilidad */
    function copyApiKey(key) {
        navigator.clipboard.writeText(key).then(() => {
            Swal.fire({ icon:'success', title:'¡Copiado!', text:'API Key copiada', timer:1500, showConfirmButton:false });
        }).catch(() => Swal.fire({ icon:'error', title:'Error', text:'No se pudo copiar' }));
    }

    /* ── ESC cierra el drawer ── */
    document.addEventListener('keydown', e => {
        if (e.key === 'Escape' && _drawerCurrentId) cerrarDrawer();
    });

    /* ═══════════════════════════════════════════════════════════════════
       CONSULTAR SALDO desde el drawer
       ═══════════════════════════════════════════════════════════════════ */
    async function consultarSaldoDrawer(tenantId, nombre) {
        Swal.fire({ title: 'Consultando saldo…', allowOutsideClick: false,
            showConfirmButton: false, didOpen: () => Swal.showLoading() });
        try {
            const r = await fetch(`/tenants/saldo-timbres?tenantId=${tenantId}`);
            const d = await r.json();
            if (!r.ok) throw new Error(d.mensaje || 'Error en la consulta');
            Swal.fire({
                icon: 'success', title: 'Saldo MultiFacturas',
                html: `<div style="text-align:center">
                    <div style="color:#9090b0;font-size:.85rem;margin-bottom:.5rem">${escHtml(d.tenantNombre || nombre)}</div>
                    <div style="font-size:2.8rem;font-weight:800;color:var(--color-vigma);margin:.5rem 0">${d.saldo ?? '—'}</div>
                    <div style="color:#9090b0;font-size:.85rem">timbres disponibles</div>
                    ${d.mensaje ? `<div style="margin-top:.75rem;font-size:.82rem;color:#9090b0;border-top:1px solid #eee;padding-top:.75rem">${escHtml(d.mensaje)}</div>` : ''}
                </div>`,
                confirmButtonColor: 'var(--color-vigma)',
                confirmButtonText: 'Cerrar'
            });
        } catch (err) {
            Swal.fire({ icon: 'error', title: 'Error al consultar', text: err.message || 'No se pudo obtener el saldo.',
                confirmButtonColor: 'var(--color-danger)' });
        }
    }

    /* ═══════════════════════════════════════════════════════════════════
       TOGGLE STATUS (Activar / Suspender)
       ═══════════════════════════════════════════════════════════════════ */
    function toggleTenantStatus(tenantId, isActive) {
        const accion = isActive ? 'suspender' : 'activar';
        Swal.fire({
            title: `¿${accion.charAt(0).toUpperCase() + accion.slice(1)} tenant?`,
            text: `¿Estás seguro de que deseas ${accion} este tenant?`,
            icon: 'warning', showCancelButton: true,
            confirmButtonColor: isActive ? 'var(--color-warning)' : 'var(--color-success)',
            cancelButtonColor: '#9090b0',
            confirmButtonText: `Sí, ${accion}`, cancelButtonText: 'Cancelar'
        }).then(res => {
            if (!res.isConfirmed) return;
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            fetch(`/Monitor/Tenants/ToggleActivo/${tenantId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token ?? '' }
            }).then(r => {
                if (r.ok) {
                    Swal.fire({ icon: 'success', title: '¡Completado!',
                        text: `Tenant ${accion}do correctamente`, timer: 1400, showConfirmButton: false
                    }).then(() => location.reload());
                } else throw new Error('Error al procesar la solicitud');
            }).catch(e => Swal.fire({ icon: 'error', title: 'Error', text: e.message }));
        });
    }

    /* ═══════════════════════════════════════════════════════════════════
       REFRESH tabla
       ═══════════════════════════════════════════════════════════════════ */
    function refreshData(btn) {
        const icon = btn.querySelector('i, span');
        if (icon) icon.classList.add('tn-spinning');
        fetch(window.location.href, { headers: {'X-Requested-With': 'XMLHttpRequest'} })
            .then(r => r.text())
            .then(html => {
                const doc = new DOMParser().parseFromString(html, 'text/html');
                const nt = doc.querySelector('.tn-table-card');
                const ot = document.querySelector('.tn-table-card');
                if (nt && ot) ot.innerHTML = nt.innerHTML;
            })
            .finally(() => { if (icon) icon.classList.remove('tn-spinning'); });
    }
</script>
}
