            <!-- ░░ Ambiente ░░ -->
            <div class="tn-attr-section">
                <div class="tn-attr-section-title">
                    <i class="bi bi-cloud-fill"></i>
                    Ambiente de Operación
                </div>
                <div>
                    <span class="tn-ambiente-badge ${d.pacProduccion ? 'prod' : 'test'}">
                        ${d.pacProduccion
                            ? '<i class="bi bi-cloud-fill"></i> Modo Producción — Timbrado Real'
