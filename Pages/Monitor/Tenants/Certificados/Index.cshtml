@page "/Monitor/Tenants/{tenantId:int}/Certificados"
@model Vigma.TimbradoGateway.Pages.Monitor.Tenants.Certificados.IndexModel
@{
    ViewData["Title"] = $"Certificados - {Model.TenantNombre}";
}

<link href="~/css/Gstyle.css" rel="stylesheet" />
<link href="~/css/timbrado.css" rel="stylesheet" />

<style>
    /* =============================================================================
       CERTIFICADOS INDEX — estilos scoped
       ============================================================================= */

    .ci-page {
        padding: var(--space-5);
        max-width: var(--container-xl);
    }

    /* ── Breadcrumb ──────────────────────────────────────────────────────────── */
    .ci-breadcrumb {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        font-size: var(--text-xs);
        color: #9090b0;
        margin-bottom: var(--space-4);
        flex-wrap: wrap;
    }

        .ci-breadcrumb a {
            color: #9090b0;
            text-decoration: none;
            transition: var(--transition-fast);
        }

            .ci-breadcrumb a:hover {
                color: var(--color-vigma);
            }

    .ci-breadcrumb-sep {
        color: #c0c0d8;
    }

    .ci-breadcrumb-current {
        color: var(--color-throughput);
        font-weight: var(--weight-semibold);
    }

    /* ── Hero ────────────────────────────────────────────────────────────────── */
    .ci-hero {
        background: var(--throughput-gradient);
        border-radius: var(--radius-xl);
        padding: var(--space-5);
        margin-bottom: var(--space-5);
        box-shadow: var(--shadow-lg);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: var(--space-4);
    }

    .ci-hero-left {
        display: flex;
        align-items: center;
        gap: var(--space-4);
    }

    .ci-hero-icon {
        width: 60px;
        height: 60px;
        border-radius: var(--radius-lg);
        background: rgba(255,255,255,0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: var(--text-3xl);
        flex-shrink: 0;
        backdrop-filter: blur(8px);
    }

    .ci-hero-title {
        font-family: var(--font-titles);
        font-weight: var(--weight-bold);
        font-size: var(--text-2xl);
        color: white;
        margin-bottom: var(--space-2);
        line-height: 1.2;
    }

    .ci-hero-meta {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        flex-wrap: wrap;
    }

    .ci-hero-badge {
        display: inline-flex;
        align-items: center;
        gap: var(--space-1);
        background: rgba(255,255,255,0.15);
        color: white;
        font-size: var(--text-xs);
        font-weight: var(--weight-medium);
        padding: var(--space-1) var(--space-3);
        border-radius: var(--radius-full);
        backdrop-filter: blur(4px);
    }

    /* ── Tabla card ──────────────────────────────────────────────────────────── */
    .ci-card {
        background: var(--bg-light-card);
        border-radius: var(--radius-xl);
        box-shadow: var(--shadow-md);
        border: 1px solid rgba(0,0,0,0.04);
        overflow: hidden;
        margin-bottom: var(--space-4);
    }

    [data-theme="dark"] .ci-card {
        background: var(--bg-dark-card);
        border-color: rgba(255,255,255,0.05);
    }

    .ci-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: var(--space-4) var(--space-5);
        border-bottom: 1px solid var(--bg-light-muted);
    }

    [data-theme="dark"] .ci-card-header {
        border-color: var(--bg-dark-muted);
    }

    .ci-card-header-title {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        font-family: var(--font-titles);
        font-weight: var(--weight-semibold);
        font-size: var(--text-base);
        color: var(--color-dark);
    }

    [data-theme="dark"] .ci-card-header-title {
        color: #e0e0f0;
    }

    .ci-card-header-title span {
        color: var(--color-throughput);
        font-size: var(--text-xl);
    }

    /* ── Tabla ───────────────────────────────────────────────────────────────── */
    .ci-table-wrap {
        overflow-x: auto;
    }

    .ci-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 720px;
    }

        .ci-table thead tr {
            background: var(--bg-light-subtle);
        }

    [data-theme="dark"] .ci-table thead tr {
        background: var(--bg-dark-subtle);
    }

    .ci-table th {
        padding: var(--space-3) var(--space-4);
        text-align: left;
        font-size: var(--text-xs);
        font-weight: var(--weight-semibold);
        color: #9090b0;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        white-space: nowrap;
    }

    .ci-table td {
        padding: var(--space-3) var(--space-4);
        border-bottom: 1px solid var(--bg-light-muted);
        font-size: var(--text-sm);
        color: var(--color-dark);
        vertical-align: middle;
    }

    [data-theme="dark"] .ci-table td {
        border-color: var(--bg-dark-muted);
        color: #c0c0d8;
    }

    .ci-table tbody tr {
        transition: var(--transition-fast);
    }

        .ci-table tbody tr:hover {
            background: var(--bg-light-subtle);
        }

    [data-theme="dark"] .ci-table tbody tr:hover {
        background: var(--bg-dark-subtle);
    }

    /* ── Celda: RFC ──────────────────────────────────────────────────────────── */
    .ci-rfc-cell {
        display: flex;
        align-items: center;
        gap: var(--space-3);
    }

    .ci-cert-icon {
        width: 38px;
        height: 38px;
        border-radius: var(--radius-md);
        background: rgba(15,155,142,0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: var(--text-lg);
        flex-shrink: 0;
    }

    .ci-rfc-text {
        font-weight: var(--weight-semibold);
        color: var(--color-dark);
        font-family: var(--font-titles);
        font-size: var(--text-sm);
    }

    [data-theme="dark"] .ci-rfc-text {
        color: #e0e0f0;
    }

    /* ── Pills estado ────────────────────────────────────────────────────────── */
    .ci-pill {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: var(--text-xs);
        font-weight: var(--weight-semibold);
        padding: 3px var(--space-2);
        border-radius: var(--radius-sm);
        white-space: nowrap;
    }

    .ci-pill-on {
        background: rgba(17,153,142,0.1);
        color: #11998e;
    }

    .ci-pill-off {
        background: var(--bg-light-subtle);
        color: #9090b0;
        border: 1px solid var(--bg-light-muted);
    }

    [data-theme="dark"] .ci-pill-off {
        background: var(--bg-dark-subtle);
        border-color: var(--bg-dark-muted);
    }

    /* ── No. Certificado ─────────────────────────────────────────────────────── */
    .ci-cert-num {
        font-family: "Consolas", monospace;
        font-size: var(--text-xs);
        background: var(--bg-light-subtle);
        color: var(--color-dark);
        padding: 3px var(--space-2);
        border-radius: var(--radius-sm);
        word-break: break-all;
    }

    [data-theme="dark"] .ci-cert-num {
        background: var(--bg-dark-subtle);
        color: #c0c0d8;
    }

    /* ── Vigencia ────────────────────────────────────────────────────────────── */
    .ci-vigencia {
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

    .ci-vig-date {
        font-size: var(--text-xs);
        font-weight: var(--weight-semibold);
        color: var(--color-dark);
    }

    [data-theme="dark"] .ci-vig-date {
        color: #c0c0d8;
    }

    .ci-vig-tag {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        font-size: 11px;
        font-weight: var(--weight-medium);
        padding: 1px 6px;
        border-radius: var(--radius-sm);
        width: fit-content;
    }

    .ci-vig-ok {
        background: rgba(17,153,142,0.1);
        color: #11998e;
    }

    .ci-vig-warn {
        background: rgba(247,151,30,0.1);
        color: #f7971e;
    }

    .ci-vig-exp {
        background: rgba(255,65,108,0.1);
        color: #ff416c;
    }

    .ci-vig-none {
        background: var(--bg-light-subtle);
        color: #9090b0;
    }

    [data-theme="dark"] .ci-vig-none {
        background: var(--bg-dark-subtle);
    }

    /* ── Acciones ────────────────────────────────────────────────────────────── */
    .ci-actions {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: var(--space-2);
    }

    .ci-act-btn {
        display: inline-flex;
        align-items: center;
        gap: var(--space-1);
        padding: var(--space-2) var(--space-3);
        border-radius: var(--radius-md);
        font-family: var(--font-body);
        font-size: var(--text-xs);
        font-weight: var(--weight-semibold);
        text-decoration: none;
        border: 1.5px solid transparent;
        cursor: pointer;
        transition: var(--transition-fast);
        white-space: nowrap;
    }

    .ci-act-details {
        background: rgba(15,155,142,0.08);
        color: var(--color-throughput);
        border-color: rgba(15,155,142,0.25);
    }

        .ci-act-details:hover {
            background: var(--color-throughput);
            color: white;
            border-color: transparent;
            box-shadow: 0 4px 12px rgba(15,155,142,0.3);
        }

    .ci-act-edit {
        background: rgba(91,91,214,0.08);
        color: var(--color-vigma);
        border-color: rgba(91,91,214,0.25);
    }

        .ci-act-edit:hover {
            background: var(--color-vigma);
            color: white;
            border-color: transparent;
            box-shadow: 0 4px 12px rgba(91,91,214,0.3);
        }

    /* ── Empty state ─────────────────────────────────────────────────────────── */
    .ci-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: var(--space-4);
        padding: var(--space-8) var(--space-5);
        text-align: center;
    }

    .ci-empty-icon {
        width: 100px;
        height: 100px;
        border-radius: var(--radius-full);
        background: var(--bg-light-subtle);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: var(--text-4xl);
    }

    [data-theme="dark"] .ci-empty-icon {
        background: var(--bg-dark-subtle);
    }

    .ci-empty-title {
        font-family: var(--font-titles);
        font-weight: var(--weight-bold);
        font-size: var(--text-xl);
        color: var(--color-dark);
    }

    [data-theme="dark"] .ci-empty-title {
        color: #e0e0f0;
    }

    .ci-empty-sub {
        font-size: var(--text-sm);
        color: #9090b0;
        max-width: 320px;
    }

    /* ── Responsive ──────────────────────────────────────────────────────────── */
    @@media (max-width: 640px) {
        .ci-act-btn span {
            display: none;
        }

        .ci-act-btn {
            padding: var(--space-2);
        }
    }
</style>

<div class="main-content">
    <div class="ci-page">

        <!-- ── Breadcrumb ────────────────────────────────────────────── -->
        <div class="ci-breadcrumb">
            <a href="/Monitor/Tenants">🏢 Tenants</a>
            <span class="ci-breadcrumb-sep">›</span>
            <a href="/Monitor/Tenants/Edit/@Model.TenantId">@Model.TenantNombre</a>
            <span class="ci-breadcrumb-sep">›</span>
            <span class="ci-breadcrumb-current">Certificados</span>
        </div>

        <!-- ── Hero ─────────────────────────────────────────────────── -->
        <div class="ci-hero">
            <div class="ci-hero-left">
                <div class="ci-hero-icon">🔐</div>
                <div>
                    <div class="ci-hero-title">Certificados Digitales</div>
                    <div class="ci-hero-meta">
                        <span class="ci-hero-badge">
                            🏢 @Model.TenantNombre
                        </span>
                        <span class="ci-hero-badge">
                            📜 @Model.Items.Count @(Model.Items.Count == 1 ? "certificado" : "certificados")
                        </span>
                        @{
                            var activos = Model.Items.Count(c => c.Activo);
                            var porExpirar = Model.Items.Count(c =>
                            c.VigenciaFin.HasValue &&
                            (c.VigenciaFin.Value - DateTime.UtcNow).Days is > 0 and <= 30);
                        }
                        @if (activos > 0)
                        {
                            <span class="ci-hero-badge">✅ @activos activos</span>
                        }
                        @if (porExpirar > 0)
                        {
                            <span class="ci-hero-badge">⚠️ @porExpirar por expirar</span>
                        }
                    </div>
                </div>
            </div>
            <a href="/Monitor/Tenants/@Model.TenantId/Certificados/Create"
               class="vg-btn"
               style="background:white; color:var(--color-throughput); font-weight:var(--weight-semibold);">
                ✚ Agregar Certificado
            </a>
        </div>

        <!-- ── Tabla / Empty ─────────────────────────────────────────── -->
        @if (!Model.Items.Any())
        {
            <div class="ci-card">
                <div class="ci-empty">
                    <div class="ci-empty-icon">🛡️</div>
                    <div class="ci-empty-title">No hay certificados registrados</div>
                    <div class="ci-empty-sub">
                        Agrega el primer certificado digital CSD para habilitar el timbrado de este tenant.
                    </div>
                    <a href="/Monitor/Tenants/@Model.TenantId/Certificados/Create"
                       class="vg-btn vg-btn-primary">
                        ✚ Agregar Primer Certificado
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="ci-card">
                <div class="ci-card-header">
                    <div class="ci-card-header-title">
                        <span>📋</span> Certificados CSD
                    </div>
                </div>
                <div class="ci-table-wrap">
                    <table class="ci-table">
                        <thead>
                            <tr>
                                <th>RFC</th>
                                <th>Estado</th>
                                <th>No. Certificado</th>
                                <th>Vigencia</th>
                                <th style="text-align:center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.Items)
                            {
                                var esValido = c.VigenciaFin.HasValue && c.VigenciaFin.Value > DateTime.UtcNow;
                                var dias = c.VigenciaFin.HasValue
                                ? (c.VigenciaFin.Value - DateTime.UtcNow).Days
                                : 0;
                                var vigCls = !c.VigenciaFin.HasValue ? "ci-vig-none"
                                : !esValido ? "ci-vig-exp"
                                : dias <= 30 ? "ci-vig-warn"
                                : "ci-vig-ok";

                                <tr>
                                    <!-- RFC -->
                                    <td>
                                        <div class="ci-rfc-cell">
                                            <div class="ci-cert-icon">🔏</div>
                                            <div class="ci-rfc-text">@c.RFC</div>
                                        </div>
                                    </td>

                                    <!-- Estado -->
                                    <td>
                                        @if (c.Activo)
                                        {
                                            <span class="ci-pill ci-pill-on">● Activo</span>
                                        }
                                        else
                                        {
                                            <span class="ci-pill ci-pill-off">○ Inactivo</span>
                                        }
                                    </td>

                                    <!-- No. Certificado -->
                                    <td>
                                        @if (!string.IsNullOrEmpty(c.NoCertificado))
                                        {
                                            <code class="ci-cert-num">@c.NoCertificado</code>
                                        }
                                        else
                                        {
                                            <span style="color:#9090b0">—</span>
                                        }
                                    </td>

                                    <!-- Vigencia -->
                                    <td>
                                        @if (c.VigenciaFin.HasValue)
                                        {
                                            <div class="ci-vigencia">
                                                <div class="ci-vig-date">
                                                    @c.VigenciaFin.Value.ToLocalTime().ToString("dd/MM/yyyy")
                                                </div>
                                                <span class="ci-vig-tag @vigCls">
                                                    @if (!esValido)
                                                    {
                                                        <span>✕ Expirado</span>
                                                    }
                                                    else if (dias <= 30)
                                                    {
                                                        <span>⚠ Expira en @dias días</span>
                                                    }
                                                    else
                                                    {
                                                        <span>✔ Vigente (@dias días)</span>
                                                    }
                                                </span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="ci-vig-tag ci-vig-none">Sin fecha</span>
                                        }
                                    </td>

                                    <!-- Acciones -->
                                    <td>
                                        <div class="ci-actions">
                                            <a href="/Monitor/Tenants/@Model.TenantId/Certificados/Details/@c.Id"
                                               class="ci-act-btn ci-act-details">
                                                👁 <span>Detalles</span>
                                            </a>
                                            <a href="/Monitor/Tenants/@Model.TenantId/Certificados/Edit/@c.Id"
                                               class="ci-act-btn ci-act-edit">
                                                ✏️ <span>Editar</span>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- ── Footer ───────────────────────────────────────────────── -->
        <a href="/Monitor/Tenants/Edit/@Model.TenantId"
           class="vg-btn vg-btn-outline">
            ← Volver al Tenant
        </a>

    </div>
</div>
