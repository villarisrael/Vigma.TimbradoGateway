@page "/Monitor/Tenants/{tenantId:int}/Certificados/Edit/{certId:int}"
@model Vigma.TimbradoGateway.Pages.Monitor.Tenants.Certificados.EditModel
@{
    ViewData["Title"] = "Editar Certificado";
}

<link href="~/css/Gstyle.css" rel="stylesheet" />

<style>
    .ed-page {
        padding: var(--space-5);
        max-width: 680px;
    }

    /* ── Breadcrumb ──────────────────────────────────────────────────── */
    .ed-breadcrumb {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        font-size: var(--text-xs);
        color: #9090b0;
        margin-bottom: var(--space-4);
        text-decoration: none;
        transition: var(--transition-fast);
    }

    .ed-breadcrumb:hover { color: var(--color-vigma); }

    .ed-breadcrumb span {
        color: var(--color-throughput);
        font-weight: var(--weight-semibold);
    }

    /* ── Header ──────────────────────────────────────────────────────── */
    .ed-header {
        display: flex;
        align-items: center;
        gap: var(--space-4);
        margin-bottom: var(--space-5);
    }

    .ed-header-icon {
        width: 52px;
        height: 52px;
        border-radius: var(--radius-md);
        background: var(--throughput-gradient);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: var(--text-2xl);
        flex-shrink: 0;
        box-shadow: 0 6px 18px rgba(15,155,142,0.35);
    }

    .ed-header-text h2 {
        font-family: var(--font-titles);
        font-weight: var(--weight-bold);
        font-size: var(--text-2xl);
        background: var(--throughput-gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: var(--space-1);
    }

    .ed-header-text p {
        font-size: var(--text-sm);
        color: var(--color-txt-light);
        margin: 0;
    }

    [data-theme="dark"] .ed-header-text p { color: #9090b0; }

    /* ── Alert ───────────────────────────────────────────────────────── */
    .ed-alert {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        padding: var(--space-3) var(--space-4);
        border-radius: var(--radius-md);
        font-size: var(--text-sm);
        margin-bottom: var(--space-4);
    }

    .ed-alert-ok  { background: rgba(17,153,142,0.08);  border: 1px solid rgba(17,153,142,0.25);  color: #11998e; }
    .ed-alert-err { background: rgba(255,65,108,0.08);  border: 1px solid rgba(255,65,108,0.25);  color: #c0203e; }

    [data-theme="dark"] .ed-alert-ok  { color: #4be3b5; }
    [data-theme="dark"] .ed-alert-err { color: #ff8099; }

    /* ── Form card ───────────────────────────────────────────────────── */
    .ed-form-card {
        background: var(--bg-light-card);
        border-radius: var(--radius-xl);
        box-shadow: var(--shadow-md);
        border: 1px solid rgba(0,0,0,0.05);
        overflow: hidden;
    }

    [data-theme="dark"] .ed-form-card {
        background: var(--bg-dark-card);
        border-color: rgba(255,255,255,0.06);
    }

    .ed-section { padding: var(--space-5); }

    .ed-section + .ed-section {
        border-top: 1px solid var(--bg-light-muted);
    }

    [data-theme="dark"] .ed-section + .ed-section {
        border-color: var(--bg-dark-muted);
    }

    .ed-section-label {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        font-size: var(--text-xs);
        font-weight: var(--weight-semibold);
        color: var(--color-throughput);
        background: rgba(15,155,142,0.1);
        padding: var(--space-1) var(--space-3);
        border-radius: var(--radius-full);
        width: fit-content;
        margin-bottom: var(--space-4);
    }

    /* ── Fields ──────────────────────────────────────────────────────── */
    .ed-field {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
        margin-bottom: var(--space-4);
    }

    .ed-field:last-child { margin-bottom: 0; }

    .ed-label {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        font-size: var(--text-sm);
        font-weight: var(--weight-semibold);
        color: var(--color-dark);
    }

    [data-theme="dark"] .ed-label { color: #e0e0f0; }

    .ed-input, .ed-select {
        width: 100%;
        padding: var(--space-3) var(--space-4);
        border: 1.5px solid var(--bg-light-muted);
        border-radius: var(--radius-md);
        background: var(--bg-light-page);
        color: var(--color-dark);
        font-family: var(--font-body);
        font-size: var(--text-sm);
        transition: var(--transition-fast);
        outline: none;
    }

    [data-theme="dark"] .ed-input, [data-theme="dark"] .ed-select {
        background: var(--bg-dark-subtle);
        border-color: var(--bg-dark-muted);
        color: #e0e0f0;
    }

    .ed-input:focus, .ed-select:focus {
        border-color: var(--color-throughput);
        box-shadow: 0 0 0 3px rgba(15,155,142,0.12);
    }

    .ed-input::placeholder { color: #9090b0; }

    .ed-hint { font-size: var(--text-xs); color: #9090b0; margin-top: var(--space-1); }

    /* ── File zone ───────────────────────────────────────────────────── */
    .ed-file-zone {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: var(--space-2);
        padding: var(--space-4);
        border: 2px dashed var(--bg-light-muted);
        border-radius: var(--radius-md);
        background: var(--bg-light-subtle);
        cursor: pointer;
        transition: var(--transition-fast);
        text-align: center;
        position: relative;
    }

    [data-theme="dark"] .ed-file-zone {
        background: var(--bg-dark-subtle);
        border-color: var(--bg-dark-muted);
    }

    .ed-file-zone:hover,
    .ed-file-zone.has-file {
        border-color: var(--color-throughput);
        background: rgba(15,155,142,0.05);
    }

    .ed-file-zone input[type="file"] {
        position: absolute;
        inset: 0;
        opacity: 0;
        cursor: pointer;
        width: 100%;
        height: 100%;
    }

    .ed-file-icon { font-size: var(--text-xl); line-height: 1; }

    .ed-file-title {
        font-size: var(--text-sm);
        font-weight: var(--weight-semibold);
        color: var(--color-dark);
    }

    [data-theme="dark"] .ed-file-title { color: #e0e0f0; }

    .ed-file-sub { font-size: var(--text-xs); color: #9090b0; }

    .ed-file-name {
        font-size: var(--text-xs);
        font-weight: var(--weight-medium);
        color: var(--color-throughput);
        display: none;
    }

    .ed-row { display: flex; gap: var(--space-4); flex-wrap: wrap; }
    .ed-row .ed-field { flex: 1 1 220px; }

    .ed-divider {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        margin: var(--space-4) 0;
        color: #9090b0;
        font-size: var(--text-xs);
        font-weight: var(--weight-semibold);
    }
    .ed-divider::before, .ed-divider::after {
        content: "";
        flex: 1;
        height: 1px;
        background: var(--bg-light-muted);
    }
    [data-theme="dark"] .ed-divider::before,
    [data-theme="dark"] .ed-divider::after { background: var(--bg-dark-muted); }

    /* ── Footer ──────────────────────────────────────────────────────── */
    .ed-form-footer {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        padding: var(--space-4) var(--space-5);
        background: var(--bg-light-subtle);
        border-top: 1px solid var(--bg-light-muted);
    }

    [data-theme="dark"] .ed-form-footer {
        background: var(--bg-dark-subtle);
        border-color: var(--bg-dark-muted);
    }
</style>

<div class="main-content">
    <div class="ed-page">

        <!-- ── Breadcrumb ────────────────────────────────────────────── -->
        <a class="ed-breadcrumb" href="/Monitor/Tenants/@Model.TenantId/Certificados">
            ← Tenants / Certificados / <span>@Model.RFC</span>
        </a>

        <!-- ── Header ───────────────────────────────────────────────── -->
        <div class="ed-header">
            <div class="ed-header-icon">🔐</div>
            <div class="ed-header-text">
                <h2>Editar Certificado</h2>
                <p>@Model.RFC</p>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Message))
        {
            <div class="ed-alert @(Model.Ok ? "ed-alert-ok" : "ed-alert-err")">
                @(Model.Ok ? "✅" : "⚠️") @Model.Message
            </div>
        }

        <!-- ── Form ─────────────────────────────────────────────────── -->
        <form method="post" enctype="multipart/form-data" class="ed-form-card">

            <div class="ed-section">
                <div class="ed-section-label">📌 Estado y contraseña</div>

                <div class="ed-row">
                    <div class="ed-field">
                        <label class="ed-label" for="Activo">Activo</label>
                        <select class="ed-select" id="Activo" asp-for="Activo">
                            <option value="true">Sí</option>
                            <option value="false">No</option>
                        </select>
                    </div>

                    <div class="ed-field">
                        <label class="ed-label" for="KeyPassword">Password (si cambió)</label>
                        <input class="ed-input" id="KeyPassword" asp-for="KeyPassword" type="password"
                               placeholder="Dejar vacío para no cambiar" autocomplete="new-password" />
                    </div>
                </div>
            </div>

            <div class="ed-section">
                <div class="ed-section-label">📂 Reemplazar archivos</div>

                <div class="ed-row">
                    <div class="ed-field">
                        <label class="ed-label">Certificado <span class="ed-hint">.cer</span></label>
                        <div class="ed-file-zone" id="zone-cer">
                            <input asp-for="CerFile" type="file" accept=".cer"
                                   onchange="markZone(this,'zone-cer','name-cer')" />
                            <div class="ed-file-icon">📜</div>
                            <div class="ed-file-title">Arrastra o haz clic</div>
                            <div class="ed-file-sub">Archivo .cer</div>
                            <div class="ed-file-name" id="name-cer"></div>
                        </div>
                    </div>

                    <div class="ed-field">
                        <label class="ed-label">Llave privada <span class="ed-hint">.key</span></label>
                        <div class="ed-file-zone" id="zone-key">
                            <input asp-for="KeyFile" type="file" accept=".key"
                                   onchange="markZone(this,'zone-key','name-key')" />
                            <div class="ed-file-icon">🗝️</div>
                            <div class="ed-file-title">Arrastra o haz clic</div>
                            <div class="ed-file-sub">Archivo .key</div>
                            <div class="ed-file-name" id="name-key"></div>
                        </div>
                    </div>
                </div>

                <div class="ed-divider">O</div>

                <div class="ed-field">
                    <label class="ed-label">Reemplazar con PFX / P12</label>
                    <div class="ed-file-zone" id="zone-pfx">
                        <input asp-for="PfxFile" type="file" accept=".pfx,.p12"
                               onchange="markZone(this,'zone-pfx','name-pfx')" />
                        <div class="ed-file-icon">📦</div>
                        <div class="ed-file-title">Arrastra o haz clic</div>
                        <div class="ed-file-sub">Archivo .pfx o .p12</div>
                        <div class="ed-file-name" id="name-pfx"></div>
                    </div>
                    <span class="ed-hint">Si subes un PFX, tiene prioridad sobre CER/KEY.</span>
                </div>
            </div>

            <div class="ed-form-footer">
                <button class="vg-btn vg-btn-primary" type="submit">Guardar cambios</button>
                <a class="vg-btn vg-btn-outline" href="/Monitor/Tenants/@Model.TenantId/Certificados">Volver</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function markZone(input, zoneId, nameId) {
            const zone = document.getElementById(zoneId);
            const nameEl = document.getElementById(nameId);
            if (input.files && input.files[0]) {
                zone.classList.add('has-file');
                nameEl.textContent = '✔ ' + input.files[0].name;
                nameEl.style.display = 'block';
            } else {
                zone.classList.remove('has-file');
                nameEl.style.display = 'none';
            }
        }
    </script>
}
