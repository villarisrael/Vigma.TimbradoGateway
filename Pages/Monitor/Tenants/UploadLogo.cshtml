@page "{id:int}"
@model Vigma.TimbradoGateway.Pages.Monitor.Tenants.UploadLogoModel
@{
    ViewData["Title"] = "Logo del Tenant";
}

<link href="~/css/Gstyle.css"    rel="stylesheet" />
<link href="~/css/timbrado.css"  rel="stylesheet" />

<style>
/* ── Upload Logo — estilos scoped ───────────────────────────────────────── */
.ul-page  { padding: var(--space-5); max-width: 580px; }

.ul-header {
    display: flex; align-items: center;
    gap: var(--space-4); margin-bottom: var(--space-5);
}

.ul-header-icon {
    width: 52px; height: 52px;
    border-radius: var(--radius-md);
    background: var(--vigma-gradient);
    display: flex; align-items: center;
    justify-content: center; font-size: var(--text-2xl);
    flex-shrink: 0; box-shadow: 0 6px 18px rgba(91,91,214,.35);
}

.ul-header-text h2 {
    font-family: var(--font-titles); font-weight: var(--weight-bold);
    font-size: var(--text-2xl);
    background: var(--vigma-gradient);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    margin-bottom: var(--space-1);
}

.ul-header-text p { font-size: var(--text-sm); color: var(--color-txt-light); margin:0; }
[data-theme="dark"] .ul-header-text p { color: #9090b0; }

/* Card */
.ul-card {
    background: var(--bg-light-card);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
    border: 1px solid rgba(0,0,0,.05);
    overflow: hidden;
}

[data-theme="dark"] .ul-card {
    background: var(--bg-dark-card);
    border-color: rgba(255,255,255,.06);
}

.ul-section { padding: var(--space-5); }
.ul-section + .ul-section { border-top: 1px solid var(--bg-light-muted); }
[data-theme="dark"] .ul-section + .ul-section { border-color: var(--bg-dark-muted); }

.ul-section-label {
    display: flex; align-items: center; gap: var(--space-2);
    font-size: var(--text-xs); font-weight: var(--weight-semibold);
    color: #f7971e; background: rgba(247,151,30,.1);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    width: fit-content; margin-bottom: var(--space-4);
}

/* Preview actual */
.ul-preview {
    display: flex; align-items: center;
    gap: var(--space-4); margin-bottom: var(--space-4);
}

.ul-preview-img {
    width: 96px; height: 96px;
    border-radius: var(--radius-lg);
    object-fit: contain;
    background: var(--bg-light-subtle);
    border: 1.5px solid var(--bg-light-muted);
    padding: 8px;
}

[data-theme="dark"] .ul-preview-img {
    background: var(--bg-dark-subtle);
    border-color: var(--bg-dark-muted);
}

.ul-no-logo {
    width: 96px; height: 96px;
    border-radius: var(--radius-lg);
    background: var(--bg-light-subtle);
    border: 1.5px dashed var(--bg-light-muted);
    display: flex; align-items: center;
    justify-content: center; font-size: var(--text-3xl);
    color: #9090b0;
}

[data-theme="dark"] .ul-no-logo {
    background: var(--bg-dark-subtle);
    border-color: var(--bg-dark-muted);
}

.ul-preview-info p {
    font-size: var(--text-xs); color: #9090b0; margin: 0 0 var(--space-2);
}

/* Drop zone */
.ul-dropzone {
    border: 2px dashed var(--bg-light-muted);
    border-radius: var(--radius-lg);
    padding: var(--space-6) var(--space-4);
    text-align: center;
    cursor: pointer;
    transition: var(--transition-fast);
    position: relative;
    background: var(--bg-light-page);
}

[data-theme="dark"] .ul-dropzone {
    border-color: var(--bg-dark-muted);
    background: var(--bg-dark-subtle);
}

.ul-dropzone:hover,
.ul-dropzone.drag-over {
    border-color: var(--color-vigma);
    background: rgba(91,91,214,.04);
}

.ul-dropzone input[type="file"] {
    position: absolute; inset: 0;
    opacity: 0; cursor: pointer; width: 100%; height: 100%;
}

.ul-dz-icon  { font-size: 2.5rem; margin-bottom: var(--space-2); }

.ul-dz-title {
    font-size: var(--text-sm); font-weight: var(--weight-semibold);
    color: var(--color-dark); margin-bottom: var(--space-1);
}

[data-theme="dark"] .ul-dz-title { color: #e0e0f0; }

.ul-dz-sub { font-size: var(--text-xs); color: #9090b0; }

.ul-dz-preview {
    display: none;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
}

.ul-dz-preview img {
    max-height: 120px; max-width: 100%;
    object-fit: contain;
    border-radius: var(--radius-md);
}

.ul-dz-filename {
    font-size: var(--text-xs); color: var(--color-vigma);
    font-weight: var(--weight-medium);
}

/* Footer */
.ul-footer {
    display: flex; align-items: center;
    gap: var(--space-3); padding: var(--space-4) var(--space-5);
    background: var(--bg-light-subtle);
    border-top: 1px solid var(--bg-light-muted);
}

[data-theme="dark"] .ul-footer {
    background: var(--bg-dark-subtle);
    border-color: var(--bg-dark-muted);
}

/* Alertas */
.ul-alert {
    display: flex; align-items: center;
    gap: var(--space-3); padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md); margin-bottom: var(--space-4);
    font-size: var(--text-sm); font-weight: var(--weight-medium);
}

.ul-alert-ok    { background: rgba(17,153,142,.08);  color: #11998e; border: 1px solid rgba(17,153,142,.25); }
.ul-alert-error { background: rgba(255,65,108,.08); color: #ff416c; border: 1px solid rgba(255,65,108,.25); }
</style>

<div class="main-content">
<div class="ul-page">

    <!-- Header -->
    <div class="ul-header">
        <div class="ul-header-icon">🖼️</div>
        <div class="ul-header-text">
            <h2>Logo del Tenant</h2>
            <p>@Model.TenantNombre · ID @Model.TenantId</p>
        </div>
    </div>

    <!-- Alertas TempData -->
    @if (!string.IsNullOrWhiteSpace(Model.MensajeOk))
    {
        <div class="ul-alert ul-alert-ok">✅ @Model.MensajeOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.MensajeError))
    {
        <div class="ul-alert ul-alert-error">❌ @Model.MensajeError</div>
    }

    <div class="ul-card">

        <!-- Sección: logo actual -->
        <div class="ul-section">
            <div class="ul-section-label">🖼 Logo actual</div>

            <div class="ul-preview">
                @if (!string.IsNullOrWhiteSpace(Model.LogoActual))
                {
                    <img class="ul-preview-img"
                         src="@Model.LogoActual?v=@DateTime.UtcNow.Ticks"
                         alt="Logo @Model.TenantNombre" />
                    <div class="ul-preview-info">
                        <p>Archivo: <code>@Model.LogoActual</code></p>
                        <form method="post" asp-page-handler="Eliminar" asp-route-id="@Model.TenantId">
                            <button type="submit" class="vg-btn vg-btn-danger-outline"
                                    onclick="return confirm('¿Eliminar el logo?')">
                                🗑 Eliminar logo
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <div class="ul-no-logo">🏢</div>
                    <div class="ul-preview-info">
                        <p>Este tenant no tiene logo aún.</p>
                    </div>
                }
            </div>
        </div>

        <!-- Sección: subir nuevo logo -->
        <form method="post" enctype="multipart/form-data"
              asp-page-handler="Upload" asp-route-id="@Model.TenantId">
            <div class="ul-section">
                <div class="ul-section-label">⬆️ Subir nuevo logo</div>

                <div class="ul-dropzone" id="dropzone">
                    <input type="file" name="logo" id="logoInput"
                           accept=".png,.jpg,.jpeg,.webp,.gif"
                           onchange="previewLogo(this)" />

                    <div id="dzDefault">
                        <div class="ul-dz-icon">📁</div>
                        <div class="ul-dz-title">Arrastra tu imagen aquí o haz clic para seleccionar</div>
                        <div class="ul-dz-sub">PNG, JPG, WEBP, GIF · Máximo 5 MB</div>
                    </div>

                    <div class="ul-dz-preview" id="dzPreview">
                        <img id="dzPreviewImg" src="#" alt="preview" />
                        <div class="ul-dz-filename" id="dzFilename"></div>
                    </div>
                </div>
            </div>

            <div class="ul-footer">
                <button type="submit" class="vg-btn vg-btn-primary" id="btnGuardar" disabled>
                    💾 Guardar logo
                </button>
                <a href="/Monitor/Tenants" class="vg-btn vg-btn-outline">← Volver</a>
            </div>
        </form>

    </div>
</div>
</div>

@section Scripts {
<script>
    const dropzone  = document.getElementById('dropzone');
    const input     = document.getElementById('logoInput');
    const btnGuardar = document.getElementById('btnGuardar');
    const dzDefault = document.getElementById('dzDefault');
    const dzPreview = document.getElementById('dzPreview');
    const dzImg     = document.getElementById('dzPreviewImg');
    const dzName    = document.getElementById('dzFilename');

    // Drag & drop visual
    dropzone.addEventListener('dragover',  e => { e.preventDefault(); dropzone.classList.add('drag-over'); });
    dropzone.addEventListener('dragleave', () => dropzone.classList.remove('drag-over'));
    dropzone.addEventListener('drop',      e => { e.preventDefault(); dropzone.classList.remove('drag-over'); });

    function previewLogo(inp) {
        const file = inp.files[0];
        if (!file) return;

        const maxMB = 5;
        if (file.size > maxMB * 1024 * 1024) {
            alert(`El archivo supera ${maxMB} MB.`);
            inp.value = '';
            return;
        }

        const reader = new FileReader();
        reader.onload = e => {
            dzImg.src     = e.target.result;
            dzName.textContent = file.name + ' (' + (file.size / 1024).toFixed(1) + ' KB)';
            dzDefault.style.display = 'none';
            dzPreview.style.display = 'flex';
            btnGuardar.disabled = false;
        };
        reader.readAsDataURL(file);
    }
</script>
}
