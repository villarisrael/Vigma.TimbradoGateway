<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Vigma Portal Cliente</title>
    <link rel="stylesheet" href="https://use.typekit.net/din3yru.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/paginaprincipal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Vigma.TimbradoGateway.styles.css" asp-append-version="true" />

    <style>
        /* ── Layout simple para portal cliente ──────────────────────────────── */
        body {
            --color-primary: #667eea;
            --color-primary-dark: #5568d3;
            --color-text: #1f2937;
            --color-bg: #f9fafb;
            --color-border: #e5e7eb;
        }

        body[data-theme="dark"] {
            --color-text: #f3f4f6;
            --color-bg: #111827;
            --color-border: #374151;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
        }

        body {
            display: flex;
            flex-direction: column;
            background-color: var(--color-bg);
            color: var(--color-text);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            line-height: 1.5;
        }

        /* ── Header / Navbar ────────────────────────────────────────────────── */
        .navbar {
            background: white;
            border-bottom: 1px solid var(--color-border);
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        body[data-theme="dark"] .navbar {
            background: #1f2937;
        }

        .navbar-brand {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-size: 1.25rem;
            font-weight: 600;
            color: var(--color-primary);
            text-decoration: none;
        }

        .navbar-brand i {
            font-size: 1.5rem;
        }

        .navbar-menu {
            display: flex;
            align-items: center;
            gap: 1.5rem;
        }

        .navbar-item {
            color: var(--color-text);
            text-decoration: none;
            font-size: 0.95rem;
            transition: color 0.2s;
        }

        .navbar-item:hover {
            color: var(--color-primary);
        }

        .navbar-user {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 1rem;
            border-radius: 6px;
            background: var(--color-bg);
        }

        /* ── Sidebar + Main ────────────────────────────────────────────────── */
        .container-main {
            display: flex;
            flex: 1;
            overflow: hidden;
        }

        .sidebar {
            width: 200px;
            background: white;
            border-right: 1px solid var(--color-border);
            padding: 1.5rem 0;
            overflow-y: auto;
        }

        body[data-theme="dark"] .sidebar {
            background: #1f2937;
        }

        .sidebar-item {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.75rem 1.5rem;
            color: var(--color-text);
            text-decoration: none;
            font-size: 0.9rem;
            border-left: 3px solid transparent;
            transition: all 0.2s;
        }

        .sidebar-item:hover,
        .sidebar-item.active {
            background: rgba(102, 126, 234, 0.1);
            color: var(--color-primary);
            border-left-color: var(--color-primary);
        }

        .sidebar-item i {
            width: 20px;
            text-align: center;
        }

        /* ── Main Content ──────────────────────────────────────────────────── */
        .main-content {
            flex: 1;
            overflow-y: auto;
            padding: 2rem;
        }

        /* ── Cards ────────────────────────────────────────────────────────── */
        .card {
            background: white;
            border: 1px solid var(--color-border);
            border-radius: 8px;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
        }

        body[data-theme="dark"] .card {
            background: #1f2937;
            border-color: #374151;
        }

        .card-title {
            font-size: 1.1rem;
            font-weight: 600;
            margin-bottom: 1rem;
        }

        /* ── Stats Grid ────────────────────────────────────────────────────── */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .stat-card {
            background: white;
            border: 1px solid var(--color-border);
            border-radius: 8px;
            padding: 1.5rem;
            text-align: center;
        }

        body[data-theme="dark"] .stat-card {
            background: #1f2937;
            border-color: #374151;
        }

        .stat-value {
            font-size: 2rem;
            font-weight: 700;
            color: var(--color-primary);
            margin: 0.5rem 0;
        }

        .stat-label {
            font-size: 0.85rem;
            color: var(--color-text);
            opacity: 0.7;
        }

        /* ── Table ────────────────────────────────────────────────────────── */
        .table-container {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.9rem;
        }

        table th {
            background: var(--color-bg);
            padding: 1rem;
            text-align: left;
            font-weight: 600;
            border-bottom: 2px solid var(--color-border);
        }

        table td {
            padding: 1rem;
            border-bottom: 1px solid var(--color-border);
        }

        table tr:hover {
            background: rgba(102, 126, 234, 0.05);
        }

        /* ── Badge ────────────────────────────────────────────────────────── */
        .badge {
            display: inline-block;
            padding: 0.25rem 0.75rem;
            border-radius: 12px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .badge-success {
            background: #d1fae5;
            color: #065f46;
        }

        body[data-theme="dark"] .badge-success {
            background: #064e3b;
            color: #a7f3d0;
        }

        .badge-danger {
            background: #fee2e2;
            color: #7f1d1d;
        }

        body[data-theme="dark"] .badge-danger {
            background: #7f1d1d;
            color: #fecaca;
        }

        /* ── Botones ───────────────────────────────────────────────────────── */
        .btn {
            padding: 0.5rem 1rem;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.9rem;
            text-decoration: none;
            display: inline-block;
            transition: all 0.2s;
        }

        .btn-primary {
            background: var(--color-primary);
            color: white;
        }

        .btn-primary:hover {
            background: var(--color-primary-dark);
        }

        .btn-logout {
            background: #ef4444;
            color: white;
        }

        .btn-logout:hover {
            background: #dc2626;
        }

        /* ── Responsive ────────────────────────────────────────────────────── */
        @@media (max-width: 768px) {
            .container-main {
                flex-direction: column;
            }

            .sidebar {
                width: 100%;
                border-right: none;
                border-bottom: 1px solid var(--color-border);
                padding: 0;
                display: flex;
                max-height: 60px;
                overflow-x: auto;
            }

            .sidebar-item {
                white-space: nowrap;
                border-left: none;
                border-bottom: 3px solid transparent;
            }

            .sidebar-item.active {
                border-left: none;
                border-bottom-color: var(--color-primary);
            }

            .main-content {
                padding: 1rem;
            }
        }

        /* ── Theme Toggle ──────────────────────────────────────────────────── */
        .theme-toggle {
            background: none;
            border: none;
            cursor: pointer;
            color: var(--color-text);
            font-size: 1.25rem;
        }
    </style>
</head>
<body>
    <!-- ── Header ──────────────────────────────────────────────────────────── -->
    <nav class="navbar">
        <a href="/Cliente/Dashboard" class="navbar-brand">
            <i class="bi bi-lightning-charge-fill"></i>
            Vigma Portal Cliente
        </a>
        <div class="navbar-menu">
            <a href="/Cliente/Dashboard" class="navbar-item">Dashboard</a>
            <a href="/Cliente/Timbrados" class="navbar-item">Timbrados</a>
            <a href="/Cliente/Errores" class="navbar-item">Errores</a>

            <button class="theme-toggle" id="themeToggle" title="Cambiar tema">
                <i class="bi bi-moon"></i>
            </button>

            <a href="/Cliente/CambiarContraseña" class="navbar-item" title="Cambiar contraseña">
                <i class="bi bi-key-fill"></i> Contraseña
            </a>

            <div class="navbar-user">
                <i class="bi bi-person-circle"></i>
                <span id="username">@User.Identity?.Name</span>
            </div>

            <form id="logoutForm" method="post" action="/Account/Logout" style="margin: 0; display: none;">
                @Html.AntiForgeryToken()
            </form>
            <button onclick="document.getElementById('logoutForm').submit();" class="btn btn-logout" style="margin: 0;">
                <i class="bi bi-box-arrow-right"></i> Salir
            </button>
        </div>
    </nav>

    <!-- ── Main Container ──────────────────────────────────────────────────── -->
    <div class="container-main">
        <aside class="sidebar">
            <a href="/Cliente/Dashboard" class="sidebar-item active">
                <i class="bi bi-speedometer2"></i>
                Dashboard
            </a>
            <a href="/Cliente/Timbrados" class="sidebar-item">
                <i class="bi bi-file-earmark-check"></i>
                Timbrados
            </a>
            <a href="/Cliente/Errores" class="sidebar-item">
                <i class="bi bi-exclamation-triangle"></i>
                Errores
            </a>
            <a href="/Cliente/CambiarContraseña" class="sidebar-item">
                <i class="bi bi-key-fill"></i>
                Contraseña
            </a>
        </aside>

        <main class="main-content">
            @RenderBody()
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        // ── Theme Toggle ──────────────────────────────────────────────────────
        const themeToggle = document.getElementById('themeToggle');
        const html = document.documentElement;

        // Cargar tema guardado
        if (localStorage.getItem('theme') === 'dark') {
            html.setAttribute('data-theme', 'dark');
            themeToggle.innerHTML = '<i class="bi bi-sun"></i>';
        }

        // Toggle al hacer click
        themeToggle.addEventListener('click', () => {
            const isDark = html.getAttribute('data-theme') === 'dark';
            html.setAttribute('data-theme', isDark ? 'light' : 'dark');
            localStorage.setItem('theme', isDark ? 'light' : 'dark');
            themeToggle.innerHTML = isDark ? '<i class="bi bi-moon"></i>' : '<i class="bi bi-sun"></i>';
        });

        // Marcar sidebar item activo
        document.querySelectorAll('.sidebar-item').forEach(item => {
            if (item.href === window.location.pathname) {
                item.classList.add('active');
            }
        });
    </script>
</body>
</html>
