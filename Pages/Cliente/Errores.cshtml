@page
@model Vigma.TimbradoGateway.Pages.Cliente.ErroresModel
@{
    ViewData["Title"] = "Errores - Portal Cliente";
    Layout = "/Pages/Shared/_LayoutCliente.cshtml";
}

<div class="container-fluid">
    <h1>
        <i class="bi bi-exclamation-triangle"></i>
        Errores de Timbrado
    </h1>

    <!-- Filtros Avanzados -->
    <div class="card">
        <h3 style="margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
            <i class="bi bi-funnel"></i>
            Filtros Avanzados
        </h3>
        <form method="get" onsubmit="return applyFilters()" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; align-items: end;">
            <div>
                <label><strong>Fecha Desde</strong></label><br>
                <input type="date" id="fechaDesde" name="fechaDesde" class="form-control" value="@(Model.FechaDesde?.ToString("yyyy-MM-dd") ?? "")">
            </div>
            <div>
                <label><strong>Fecha Hasta</strong></label><br>
                <input type="date" id="fechaHasta" name="fechaHasta" class="form-control" value="@(Model.FechaHasta?.ToString("yyyy-MM-dd") ?? "")">
            </div>
            <div>
                <label><strong>Código de Error</strong></label><br>
                <input type="text" id="codigoMf" name="codigoMf" class="form-control" placeholder="Ej: 301, 302..." value="@Model.CodigoMf">
            </div>
            <div>
                <label><strong>Tenant</strong></label><br>
                <select id="tenantFilter" name="SelectedTenantId" class="form-control">
                    <option value="">Todos</option>
                    @if (Model.Tenants?.Any() == true)
                    {
                        @foreach (var tenant in Model.Tenants)
                        {
                            if (Model.SelectedTenantId == tenant.Id)
                            {
                                <option value="@tenant.Id" selected="true">@tenant.Nombre</option>
                            }
                            else
                            {
                                <option value="@tenant.Id">@tenant.Nombre</option>
                            }
                        }
                    }
                </select>
            </div>
            <div style="display: flex; gap: 0.5rem;">
                <button type="submit" class="btn btn-primary" style="flex: 1;">
                    <i class="bi bi-search"></i> Filtrar
                </button>
                <button type="button" onclick="clearFilters()" class="btn btn-secondary" style="flex: 1;">
                    <i class="bi bi-arrow-clockwise"></i> Limpiar
                </button>
            </div>
        </form>
    </div>

    <!-- Tabla de Errores -->
    <div class="card">
        @if (Model.Errores?.Any() == true)
        {
            <div style="margin-bottom: 1rem;">
                <span style="background: #fee2e2; color: #7f1d1d; padding: 0.5rem 1rem; border-radius: 6px;">
                    <strong>⚠️ Total de errores mostrados:</strong> @Model.Errores.Count
                </span>
            </div>

            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Tenant</th>
                            <th>RFC Emisor</th>
                            <th>Código Error</th>
                            <th>Mensaje</th>
                            <th>Fecha</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var error in Model.Errores)
                        {
                            <tr>
                                <td><code>@error.Id</code></td>
                                <td>@error.TenantName</td>
                                <td><strong>@error.RfcEmisor</strong></td>
                                <td><code style="color: #ef4444;">@error.CodigoMf</code></td>
                                <td>
                                    <span title="@error.MensajeMf" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 300px; display: block;">
                                        @error.MensajeMf
                                    </span>
                                </td>
                                <td>@(error.FechaAlta != default ? error.FechaAlta.ToString("yyyy-MM-dd HH:mm") : "N/A")</td>
                                <td>
                                    <button onclick="showDetallesError(@error.Id, '@error.CodigoMf', '@error.MensajeMf', '@error.TenantName', '@error.RfcEmisor', '@(error.FechaAlta.ToString("yyyy-MM-dd HH:mm"))')" class="btn btn-info" style="padding: 0.25rem 0.5rem; font-size: 0.85rem;">
                                        <i class="bi bi-info-circle"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--color-border);">
                <small><strong>Total:</strong> @Model.Errores.Count registros mostrados</small>
            </div>
        }
        else
        {
            <p style="color: var(--color-text); opacity: 0.7; text-align: center; padding: 2rem;">
                <i class="bi bi-check-circle" style="font-size: 2rem; color: #10b981; opacity: 0.5;"></i><br>
                ✓ No hay errores registrados. ¡Excelente!
            </p>
        }
    </div>

    <!-- Estadísticas -->
    <div class="card">
        <h3 style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem;">
            <i class="bi bi-bar-chart"></i>
            Resumen de Errores
        </h3>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
            <div style="border: 1px solid var(--color-border); padding: 1rem; border-radius: 6px;">
                <div style="font-size: 0.85rem; opacity: 0.7;">Total Errores</div>
                <div style="font-size: 1.5rem; font-weight: 700; color: #ef4444;">@Model.ErroresCount</div>
            </div>

            <div style="border: 1px solid var(--color-border); padding: 1rem; border-radius: 6px;">
                <div style="font-size: 0.85rem; opacity: 0.7;">Errores Hoy</div>
                <div style="font-size: 1.5rem; font-weight: 700; color: #ef4444;">@Model.ErroresHoy</div>
            </div>

            <div style="border: 1px solid var(--color-border); padding: 1rem; border-radius: 6px;">
                <div style="font-size: 0.85rem; opacity: 0.7;">Error Más Frecuente</div>
                <div style="font-size: 0.9rem; font-weight: 600; font-family: monospace;">
                    @(string.IsNullOrWhiteSpace(Model.ErrorMasFrecuente) ? "N/A" : Model.ErrorMasFrecuente)
                </div>
            </div>
        </div>
    </div>
</div>

<div id="detallesErrorModal" class="modal" style="display: none;">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Detalles del Error</h2>
            <button onclick="closeModal('detallesErrorModal')" class="modal-close">&times;</button>
        </div>
        <div class="modal-body">
            <div style="display: grid; gap: 1rem;">
                <div>
                    <label style="display: block; margin-bottom: 0.25rem; opacity: 0.7; font-size: 0.9rem;"><strong>Código de Error</strong></label>
                    <code id="modalCodigoError" style="display: block; padding: 0.75rem; background: var(--color-bg); border-radius: 4px; color: #ef4444; font-weight: 600;"></code>
                </div>
                <div>
                    <label style="display: block; margin-bottom: 0.25rem; opacity: 0.7; font-size: 0.9rem;"><strong>Mensaje de Error</strong></label>
                    <code id="modalMensajeError" style="display: block; padding: 0.75rem; background: var(--color-bg); border-radius: 4px; word-break: break-word; white-space: pre-wrap;"></code>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                    <div>
                        <label style="display: block; margin-bottom: 0.25rem; opacity: 0.7; font-size: 0.9rem;"><strong>Tenant</strong></label>
                        <code id="modalTenantError" style="display: block; padding: 0.75rem; background: var(--color-bg); border-radius: 4px;"></code>
                    </div>
                    <div>
                        <label style="display: block; margin-bottom: 0.25rem; opacity: 0.7; font-size: 0.9rem;"><strong>RFC Emisor</strong></label>
                        <code id="modalRfcError" style="display: block; padding: 0.75rem; background: var(--color-bg); border-radius: 4px;"></code>
                    </div>
                </div>
                <div>
                    <label style="display: block; margin-bottom: 0.25rem; opacity: 0.7; font-size: 0.9rem;"><strong>Fecha</strong></label>
                    <code id="modalFechaError" style="display: block; padding: 0.75rem; background: var(--color-bg); border-radius: 4px;"></code>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button onclick="closeModal('detallesErrorModal')" class="btn btn-secondary">Cerrar</button>
        </div>
    </div>
</div>

<style>
    .container-fluid {
        max-width: 1400px;
    }

    h1 {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 2rem;
        font-size: 1.75rem;
    }

    h3 {
        margin: 0 0 1rem 0;
        font-size: 1.1rem;
    }

    .form-control {
        padding: 0.5rem;
        border: 1px solid var(--color-border);
        border-radius: 6px;
        background: white;
        color: var(--color-text);
        width: 100%;
    }

    body[data-theme="dark"] .form-control {
        background: #374151;
        border-color: #4b5563;
    }

    code {
        background: var(--color-bg);
        padding: 0.2rem 0.4rem;
        border-radius: 3px;
        font-family: monospace;
        font-size: 0.85rem;
    }

    .btn {
        padding: 0.5rem 1rem;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-size: 0.95rem;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
    }

    .btn-primary {
        background: var(--color-primary);
        color: white;
    }

    .btn-primary:hover {
        background: var(--color-primary-dark);
    }

    .btn-secondary {
        background: #6b7280;
        color: white;
    }

    .btn-secondary:hover {
        background: #4b5563;
    }

    .btn-info {
        background: #0ea5e9;
        color: white;
    }

    .btn-info:hover {
        background: #0284c7;
    }

    /* Modal Styles */
    .modal {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }

    .modal-content {
        background: white;
        border-radius: 8px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
        max-width: 600px;
        width: 90%;
        max-height: 80vh;
        overflow-y: auto;
    }

    body[data-theme="dark"] .modal-content {
        background: #1f2937;
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.5rem;
        border-bottom: 1px solid var(--color-border);
    }

    .modal-header h2 {
        margin: 0;
        font-size: 1.3rem;
    }

    .modal-close {
        background: none;
        border: none;
        font-size: 2rem;
        cursor: pointer;
        color: var(--color-text);
        opacity: 0.6;
        transition: opacity 0.2s;
    }

    .modal-close:hover {
        opacity: 1;
    }

    .modal-body {
        padding: 1.5rem;
    }

    .modal-footer {
        padding: 1rem 1.5rem;
        border-top: 1px solid var(--color-border);
        display: flex;
        justify-content: flex-end;
        gap: 0.5rem;
    }

    .card {
        background: white;
        border: 1px solid var(--color-border);
        border-radius: 8px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }

    body[data-theme="dark"] .card {
        background: #1f2937;
    }

    .table-container {
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.95rem;
    }

    table thead {
        background: var(--color-bg);
    }

    body[data-theme="dark"] table thead {
        background: #111827;
    }

    table th {
        padding: 0.75rem;
        text-align: left;
        font-weight: 600;
        border-bottom: 2px solid var(--color-border);
    }

    table td {
        padding: 0.75rem;
        border-bottom: 1px solid var(--color-border);
    }

    table tbody tr:hover {
        background: rgba(102, 126, 234, 0.05);
    }

    body[data-theme="dark"] table tbody tr:hover {
        background: rgba(102, 126, 234, 0.1);
    }
</style>

<script>
    function applyFilters() {
        // El formulario se envía naturalmente
        return true;
    }

    function clearFilters() {
        document.getElementById('fechaDesde').value = '';
        document.getElementById('fechaHasta').value = '';
        document.getElementById('codigoMf').value = '';
        document.getElementById('tenantFilter').value = '';
        // Recargar página sin filtros
        window.location.href = window.location.pathname;
    }

    function showDetallesError(id, codigo, mensaje, tenant, rfc, fecha) {
        document.getElementById('modalCodigoError').textContent = codigo || 'N/A';
        document.getElementById('modalMensajeError').textContent = mensaje || 'N/A';
        document.getElementById('modalTenantError').textContent = tenant || 'N/A';
        document.getElementById('modalRfcError').textContent = rfc || 'N/A';
        document.getElementById('modalFechaError').textContent = fecha || 'N/A';

        const modal = document.getElementById('detallesErrorModal');
        modal.style.display = 'flex';
    }

    function closeModal(modalId) {
        const modal = document.getElementById(modalId);
        modal.style.display = 'none';
    }

    // Cerrar modal al hacer clic fuera de él
    document.addEventListener('click', function(event) {
        const modal = document.getElementById('detallesErrorModal');
        if (event.target === modal) {
            closeModal('detallesErrorModal');
        }
    });
</script>
