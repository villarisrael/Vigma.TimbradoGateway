@page
@model Vigma.TimbradoGateway.Pages.Cliente.DashboardModel
@{
    ViewData["Title"] = "Dashboard - Portal Cliente";
    Layout = "/Pages/Shared/_LayoutCliente.cshtml";
}

<div class="container-fluid">
    <h1>
        <i class="bi bi-speedometer2"></i>
        Dashboard
    </h1>

    <!-- Cliente Info -->
    @if (Model.Cliente != null)
    {
        <div class="card">
            <div style="display: flex; align-items: center; gap: 1rem;">
                @if (!string.IsNullOrWhiteSpace(Model.Cliente.LogoPath))
                {
                    <img src="@Model.Cliente.LogoPath" alt="@Model.Cliente.Nombre" style="max-width: 80px; height: auto; border-radius: 6px;">
                }
                <div>
                    <h2>@Model.Cliente.Nombre</h2>
                    @if (!string.IsNullOrWhiteSpace(Model.Cliente.Rfc))
                    {
                        <p><strong>RFC:</strong> @Model.Cliente.Rfc</p>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Estadísticas -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-label">Tenants Activos</div>
            <div class="stat-value">@Model.TenantCount</div>
        </div>

        <div class="stat-card">
            <div class="stat-label">Timbrados Hoy</div>
            <div class="stat-value" style="color: #10b981;">@Model.TimbradosCount</div>
        </div>

        <div class="stat-card">
            <div class="stat-label">Errores Hoy</div>
            <div class="stat-value" style="color: @(Model.ErroresCount > 0 ? "#ef4444" : "#10b981");">@Model.ErroresCount</div>
        </div>

        <div class="stat-card">
            <div class="stat-label">Tasa de Éxito</div>
            <div class="stat-value">
                @{
                    var total = Model.TimbradosCount + Model.ErroresCount;
                    var tasa = total > 0 ? Math.Round((Model.TimbradosCount * 100.0) / total, 1) : 100;
                }
                @tasa%
            </div>
        </div>
    </div>

    <!-- Tenants -->
    <div class="card">
        <h3 class="card-title">
            <i class="bi bi-diagram-3"></i>
            Mis Tenants
        </h3>

        @if (Model.Tenants?.Any() == true)
        {
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tenant in Model.Tenants)
                        {
                            <tr>
                                <td>#@tenant.Id</td>
                                <td>
                                    <strong>@tenant.Nombre</strong>
                                </td>
                                <td>
                                    <span class="badge @(tenant.Activo ? "badge-success" : "badge-danger")">
                                        @(tenant.Activo ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p style="color: var(--color-text); opacity: 0.7;">No tienes tenants asignados.</p>
        }
    </div>

    <!-- Quick Links -->
    <div class="card">
        <h3 class="card-title">
            <i class="bi bi-lightning"></i>
            Acciones Rápidas
        </h3>
        <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
            <a href="/Cliente/Timbrados" class="btn btn-primary">
                <i class="bi bi-file-earmark-check"></i>
                Ver Timbrados
            </a>
            <a href="/Cliente/Errores" class="btn btn-primary">
                <i class="bi bi-exclamation-triangle"></i>
                Ver Errores
            </a>
        </div>
    </div>
</div>

<style>
    .container-fluid {
        max-width: 1200px;
    }

    h1 {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 2rem;
        font-size: 1.75rem;
    }

    h2 {
        margin: 0;
        color: var(--color-primary);
    }

    h3 {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0;
    }
</style>
