@model Vigma.TimbradoGateway.Models.Alertas.FcmTokenIndiceVM
@{
    ViewData["Title"] = "Tokens FCM";
    var from = Model.Total == 0 ? 0 : ((Model.Filtro.Pagina - 1) * Model.Filtro.TamanoPagina) + 1;
    var to   = Math.Min(Model.Filtro.Pagina * Model.Filtro.TamanoPagina, Model.Total);
    int totalPages = Model.Total == 0 ? 1 : (int)Math.Ceiling((double)Model.Total / Model.Filtro.TamanoPagina);
}

<link href="~/css/timbrado.css" rel="stylesheet" />

<div class="container-fluid py-4">

    <span class="page-badge mb-2" style="color:#3b82f6; background:rgba(59,130,246,0.1);">
        <i class="bi bi-phone-fill"></i> SAK Alerts
    </span>

    <div class="page-header py-2 mb-4">
        <div class="d-flex flex-column flex-lg-row align-items-start align-items-lg-center justify-content-between gap-2">
            <div>
                <h1 class="h3 fw-bold mb-1">Tokens FCM</h1>
                <div class="text-muted small">Dispositivos registrados para recibir alertas push</div>
            </div>
            <div class="d-flex gap-2">
                <a href="@Url.Action("Dashboard","Alerts")" class="btn btn-outline-soft btn-sm">
                    <i class="bi bi-speedometer2 me-1"></i> Dashboard
                </a>
                <a href="@Url.Action("Logs","Alerts")" class="btn btn-outline-soft btn-sm">
                    <i class="bi bi-list-ul me-1"></i> Logs
                </a>
            </div>
        </div>
    </div>

    <!-- KPIs -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4">
            <div class="filter-card py-3 px-4" style="border-left:3px solid #3b82f6;">
                <div class="small text-muted mb-1"><i class="bi bi-phone me-1"></i> Total tokens</div>
                <div class="h3 fw-bold mb-0" style="color:#3b82f6;">@Model.Total</div>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="filter-card py-3 px-4" style="border-left:3px solid #22c55e;">
                <div class="small text-muted mb-1"><i class="bi bi-check-circle me-1"></i> Activos</div>
                <div class="h3 fw-bold mb-0" style="color:#22c55e;">@Model.Activos</div>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="filter-card py-3 px-4" style="border-left:3px solid #94a3b8;">
                <div class="small text-muted mb-1"><i class="bi bi-x-circle me-1"></i> Inactivos</div>
                <div class="h3 fw-bold mb-0" style="color:#94a3b8;">@Model.Inactivos</div>
            </div>
        </div>
    </div>

    <!-- Filtros -->
    <div class="filter-card tb-filter-card">
        <h5 class="fw-bold mb-4">
            <i class="bi bi-funnel-fill me-2" style="color:#f59e0b;"></i>Filtros
        </h5>
        <form asp-action="Tokens" asp-controller="Alerts" method="get">
            <input type="hidden" name="pagina" value="1" />
            <input type="hidden" name="tamanoPagina" value="@Model.Filtro.TamanoPagina" />
            <div class="row g-3 align-items-end">
                <div class="col-md-2">
                    <label class="form-label small fw-bold mb-2"><i class="bi bi-people me-1"></i> Tenant</label>
                    <select name="tenantId" class="form-select form-select-sm">
                        @foreach (var t in (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Tenants)
                        { <option value="@t.Value" >@t.Text</option> }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold mb-2"><i class="bi bi-person-badge me-1"></i> Entidad ID</label>
                    <input type="text" name="entidadId" value="@Model.Filtro.EntidadId"
                           class="form-control form-control-sm" placeholder="ID trabajador..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold mb-2"><i class="bi bi-person me-1"></i> Nombre</label>
                    <input type="text" name="entidadNombre" value="@Model.Filtro.EntidadNombre"
                           class="form-control form-control-sm" placeholder="Nombre del trabajador..." />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold mb-2"><i class="bi bi-toggle-on me-1"></i> Estado</label>
                    <select name="activo" class="form-select form-select-sm">
                        <option value="">Todos</option>
                        <option value="true"  >Activo</option>
                        <option value="false" >Inactivo</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-gold w-100"><i class="bi bi-search me-2"></i> Buscar</button>
                    <a class="btn btn-outline-soft w-100" href="@Url.Action("Tokens","Alerts")">
                        <i class="bi bi-arrow-clockwise me-2"></i> Limpiar
                    </a>
                </div>
            </div>
        </form>
    </div>

    <!-- Tabla -->
    <div class="table-card">
        <div class="table-header">
            <div class="d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0"><i class="bi bi-phone me-2" style="color:#3b82f6;"></i>Tokens registrados</h6>
                <span class="badge bg-light text-dark">@from–@to de @Model.Total</span>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0 tb-table">
                <thead>
                    <tr>
                        <th>Tenant</th><th>Entidad ID</th><th>Nombre</th>
                        <th>Token</th><th>Estado</th><th>Días sin actualizar</th>
                        <th>Creado UTC</th><th>Actualizado UTC</th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Tokens.Any())
                {
                    <tr><td colspan="8">
                        <div class="empty-state">
                            <div class="empty-state-icon"><i class="bi bi-phone-x"></i></div>
                            <h5 class="fw-bold mb-2">No hay tokens registrados</h5>
                            <p class="text-muted mb-0">Los tokens se crean automáticamente cuando los trabajadores inician sesión en SAK Alerts.</p>
                        </div>
                    </td></tr>
                }
                else
                {
                    foreach (var r in Model.Tokens)
                    {
                        <tr>
                            <td><span class="tb-pill tb-pill-mid"><i class="bi bi-person-badge"></i> @r.TenantNombre</span></td>
                            <td><code class="mono">@r.EntidadId</code></td>
                            <td class="tb-plain">@(r.EntidadNombre ?? "—")</td>
                            <td><code class="mono" style="font-size:0.72rem;opacity:.65;" title="Token FCM (preview)">@r.TokenPreview</code></td>
                            <td>
                                @if (r.Activo) {
                                    <span class="tb-pill tb-pill-ok"><i class="bi bi-check-circle-fill"></i> Activo</span>
                                } else {
                                    <span class="tb-pill tb-pill-cancel"><i class="bi bi-x-circle-fill"></i> Inactivo</span>
                                }
                            </td>
                            <td>
                                @if (r.DiasSinActualizar>0) {
                                    var d = r.DiasSinActualizar;
                                    var col = d > 30 ? "#ef4444" : d > 7 ? "#f59e0b" : "#22c55e";
                                    <span class="tb-pill" style="background:rgba(0,0,0,0.04);color:@col;">
                                        <i class="bi bi-clock"></i> @d d
                                    </span>
                                } else { <span class="tb-plain">—</span> }
                            </td>
                            <td><span class="tb-pill tb-pill-mid"><i class="bi bi-calendar"></i> @r.CreadoUtc.ToString("yyyy-MM-dd HH:mm")</span></td>
                            <td><span class="tb-pill tb-pill-mid"><i class="bi bi-arrow-repeat"></i> @r.ActualizadoUtc.ToString("yyyy-MM-dd HH:mm")</span></td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>

        @if (totalPages > 1)
        {
            <div class="tb-pagination">
                <span class="tb-page-info">
                    Página <strong>@Model.Filtro.Pagina</strong> de <strong>@totalPages</strong>
                </span>
                <div class="tb-page-btns">
                    @{
                        int ps = Math.Max(1, Model.Filtro.Pagina - 3);
                        int pe = Math.Min(totalPages, ps + 6); ps = Math.Max(1, pe - 6);
                        Func<int,string?> pu = p => Url.Action("Tokens","Alerts", new {
                            tenantId=Model.Filtro.TenantId, entidadId=Model.Filtro.EntidadId,
                            entidadNombre=Model.Filtro.EntidadNombre, activo=Model.Filtro.Activo,
                            tamanoPagina=Model.Filtro.TamanoPagina, pagina=p });
                    }
                    <a href="@pu(Model.Filtro.Pagina-1)" class="tb-page-btn @(Model.Filtro.Pagina<=1?"tb-page-btn-disabled":"")">«</a>
                    @for (int p = ps; p <= pe; p++) {
                        <a href="@pu(p)" class="tb-page-btn @(p==Model.Filtro.Pagina?"tb-page-btn-active":"")">@p</a>
                    }
                    <a href="@pu(Model.Filtro.Pagina+1)" class="tb-page-btn @(Model.Filtro.Pagina>=totalPages?"tb-page-btn-disabled":"")">»</a>
                </div>
            </div>
        }
    </div>
</div>
