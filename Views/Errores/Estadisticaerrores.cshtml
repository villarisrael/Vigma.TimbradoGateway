@model Vigma.TimbradoGateway.ViewsModels.Errores.EstadisticasErroresVM
@{
    ViewData["Title"] = "Estadísticas de Errores";
    Layout = "_Layout";
}

<link href="~/css/Gstyle.css" rel="stylesheet" />
<link href="~/css/Errores.css" rel="stylesheet" />

<div class="errores-page">

    <!-- ── Header ── -->
    <div class="errores-header">
        <div class="errores-header-left">
            <h1 class="errores-title">Monitor de Errores</h1>
            <span class="errores-subtitle">Datos en tiempo real · Últimas 24 h / 7 días / 30 días</span>
        </div>
        <div class="errores-header-right">
            <a href="/Errores/Detalle" class="vg-btn vg-btn-outline">Ver detalle</a>
            <a href="/Errores/index" class="vg-btn vg-btn-outline-wrong">Errores crudos</a>
        </div>
    </div>

    <!-- ── Anillos estadísticos ── -->
    <div class="errores-rings-grid">

        <!-- Anillo 1 — Total últimas 24 h -->
        <div class="errores-ring-card">
            <div class="errores-ring-card-header">
                <div>
                    <span class="errores-ring-label">Errores</span>
                    <h4 class="errores-ring-title">Total 24 h</h4>
                </div>
                <span class="errores-ring-badge badge-danger">24h</span>
            </div>
            <div class="errores-ring-chart-wrap">
                <canvas id="ringTotal" width="200" height="200"></canvas>
                <div class="errores-ring-center">
                    <span class="errores-ring-value" id="totalValue">@Model.TotalHoy</span>
                    <span class="errores-ring-unit">errores</span>
                </div>
            </div>
            <div class="errores-ring-legend">
                <span class="ring-legend-item">
                    <span class="ring-legend-dot" style="background:#f7971e"></span>
                    Esta semana <strong>@Model.TotalSemana</strong>
                </span>
                <span class="ring-legend-item">
                    <span class="ring-legend-dot" style="background:#5b5bd6"></span>
                    Este mes <strong>@Model.TotalMes</strong>
                </span>
            </div>
            <p class="errores-ring-footer">Total de errores de timbrado por periodo</p>
        </div>

        <!-- Anillo 2 — Categorías (últimas 24 h) -->
        <div class="errores-ring-card">
            <div class="errores-ring-card-header">
                <div>
                    <span class="errores-ring-label">Errores</span>
                    <h4 class="errores-ring-title">Tipos de errores</h4>
                </div>
                <span class="errores-ring-badge badge-throughput" id="badge-resolucion">24h</span>
            </div>
            <div class="errores-ring-chart-wrap">
                <canvas id="ringCategorias" width="200" height="200"></canvas>
                <div class="errores-ring-center">
                    <span class="errores-ring-value" id="catValue">—</span>
                    <span class="errores-ring-unit">categoría top</span>
                </div>
            </div>
            <div class="errores-ring-legend">
                <span class="ring-legend-item">
                    <span class="ring-legend-dot" style="background:#ff416c"></span>
                    SAT / Firma <strong id="legCat1">@Model.CatSat</strong>
                </span>
                <span class="ring-legend-item">
                    <span class="ring-legend-dot" style="background:#f7971e"></span>
                    Certificado <strong id="legCat2">@Model.CatCertificado</strong>
                </span>
                <span class="ring-legend-item">
                    <span class="ring-legend-dot" style="background:#5b5bd6"></span>
                    Timeout <strong id="legCat3">@Model.CatTimeout</strong>
                </span>
                <span class="ring-legend-item">
                    <span class="ring-legend-dot" style="background:#0f9b8e"></span>
                    Otros <strong id="legCat4">@Model.CatOtros</strong>
                </span>
            </div>
            <p class="errores-ring-footer" id="resolucionFooter">
                Clasificación de errores en las últimas 24 h
            </p>
        </div>

    </div>

    <!-- ── Top tenants con más errores ── -->
    <div class="errores-top-card">
        <div class="errores-top-header">
            <div>
                <h4 class="errores-top-title">Top 10 con más errores</h4>
                <span class="errores-top-subtitle">Ordenado por total de errores en el periodo seleccionado</span>
            </div>
            <select class="chart-select" id="topFilter" onchange="cambiarPeriodo()">
                <option value="hoy">Hoy (24 h)</option>
                <option value="semana" selected>Esta semana (7 d)</option>
                <option value="mes">Este mes (30 d)</option>
            </select>
        </div>

        <div class="errores-top-list" id="topList"></div>

        <div class="errores-top-more">
            <button class="errores-top-toggle" onclick="toggleTop()">
                <span id="topToggleText">Ver más</span>
                <i class="bi bi-chevron-down" id="topToggleIcon"></i>
            </button>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // ── Datos reales desde el servidor ──────────────────────────────────
        const serverStats = @Html.Raw(ViewBag.StatsJson);

        // Estructura que los helpers esperan
        const datosErrores = {
            total:      serverStats.total,
            semana:     serverStats.totalSemana,
            mes:        serverStats.totalMes,
            categorias: serverStats.categorias
        };

        const topPorPeriodo = {
            hoy:    serverStats.topHoy,
            semana: serverStats.topSemana,
            mes:    serverStats.topMes
        };

        let topExpandido = false;
        let topActual    = topPorPeriodo.semana;

        // ── Anillo 1: Total 24h + semana + mes ──────────────────────────────
        function dibujarRingTotal(datos) {
            const ctx = document.getElementById('ringTotal').getContext('2d');
            if (window._chartTotal) window._chartTotal.destroy();

            // Si no hay errores mostramos el anillo vacío
            const vals = datos.total > 0
                ? [datos.total, datos.semana - datos.total, datos.mes - datos.semana]
                : [1];
            const colors = datos.total > 0
                ? ['#ff416c', '#f7971e', '#5b5bd6']
                : ['#e0e0e0'];

            window._chartTotal = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    datasets: [{
                        data: vals,
                        backgroundColor: colors,
                        borderWidth: 0, borderRadius: 4, spacing: 2
                    }]
                },
                options: {
                    cutout: '75%', responsive: false,
                    plugins: { legend: { display: false }, tooltip: { enabled: false } }
                }
            });
        }

        // ── Anillo 2: Categorías 24h ─────────────────────────────────────────
        function dibujarRingCategorias(datos) {
            const ctx = document.getElementById('ringCategorias').getContext('2d');
            const cats = datos.categorias;
            const total = cats.sat + cats.certificado + cats.timeout + cats.otros;

            // Nombre de la categoría dominante
            const nombres = ['SAT/Firma', 'Certificado', 'Timeout', 'Otros'];
            const valores = [cats.sat, cats.certificado, cats.timeout, cats.otros];
            const maxIdx  = valores.indexOf(Math.max(...valores));
            document.getElementById('catValue').textContent = total > 0 ? nombres[maxIdx] : '—';

            if (window._chartCats) window._chartCats.destroy();

            const chartVals = total > 0 ? valores : [1];
            const chartColors = total > 0
                ? ['#ff416c', '#f7971e', '#5b5bd6', '#0f9b8e']
                : ['#e0e0e0'];

            window._chartCats = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    datasets: [{
                        data: chartVals,
                        backgroundColor: chartColors,
                        borderWidth: 0, borderRadius: 4, spacing: 2
                    }]
                },
                options: {
                    cutout: '75%', responsive: false,
                    plugins: { legend: { display: false }, tooltip: { enabled: false } }
                }
            });
        }

        // ── Lista Top ────────────────────────────────────────────────────────
        function renderTop(items) {
            const list = document.getElementById('topList');
            if (!items || items.length === 0) {
                list.innerHTML = '<div style="padding:16px;color:#888;text-align:center;">Sin errores en el periodo</div>';
                return;
            }
            const max     = items[0].errores || 1;
            const visibles = topExpandido ? items : items.slice(0, 3);
            list.innerHTML = visibles.map((item, i) => {
                const rank     = i + 1;
                const rankClass = rank === 1 ? 'rank-1' : rank === 2 ? 'rank-2' : rank === 3 ? 'rank-3' : 'rank-other';
                const bgClass   = rank === 1 ? 'rank-bg-1' : rank === 2 ? 'rank-bg-2' : rank === 3 ? 'rank-bg-3' : 'rank-bg-other';
                const barWidth  = Math.round((item.errores / max) * 100);
                // Truncar meta larga
                const metaCorta = item.meta && item.meta.length > 60 ? item.meta.substring(0, 60) + '…' : (item.meta || '—');
                return `
                <div class="errores-top-item ${rankClass}">
                    <div class="errores-top-rank ${bgClass}">${rank}</div>
                    <div class="errores-top-info">
                        <span class="errores-top-name">${item.nombre}</span>
                        <span class="errores-top-meta">${metaCorta}</span>
                    </div>
                    <span class="errores-top-count">${item.errores}</span>
                    <div class="errores-top-bar" style="width:${barWidth}%"></div>
                </div>`;
            }).join('');
        }

        function cambiarPeriodo() {
            const periodo = document.getElementById('topFilter').value;
            topActual = topPorPeriodo[periodo] || [];
            topExpandido = false;
            document.getElementById('topToggleText').textContent = 'Ver más';
            document.getElementById('topToggleIcon').className = 'bi bi-chevron-down';
            renderTop(topActual);
        }

        function toggleTop() {
            topExpandido = !topExpandido;
            document.getElementById('topToggleText').textContent = topExpandido ? 'Ver menos' : 'Ver más';
            document.getElementById('topToggleIcon').className = topExpandido ? 'bi bi-chevron-up' : 'bi bi-chevron-down';
            renderTop(topActual);
        }

        // ── Init ─────────────────────────────────────────────────────────────
        dibujarRingTotal(datosErrores);
        dibujarRingCategorias(datosErrores);
        renderTop(topActual);

    </script>
}
