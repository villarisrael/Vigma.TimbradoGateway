@model Vigma.TimbradoGateway.ViewModels.Timbrados.TimbradoDetalleVM
@{
    ViewData["Title"] = $"Timbrado #{Model.Id} - Detalle";
    Layout = "_Layout";
    var fileNameXml = $"{Model.Uuid}.xml";

    string V(string? val) => string.IsNullOrWhiteSpace(val) ? "—" : val;
}

<link href="~/css/Gstyle.css" rel="stylesheet" />
<link href="~/css/Errores.css" rel="stylesheet" />
<link href="~/css/Timbrado.css" rel="stylesheet" />

<style>
    /* ── Comprobante detail grid ─────────────────────────────── */
    .cfdi-section {
        margin-top: 16px;
    }
    .cfdi-section-title {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #6c757d;
        padding: 0 0 8px 2px;
        margin: 0 0 4px 0;
        border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    }
    .cfdi-fields {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
        gap: 12px 20px;
        padding-top: 10px;
    }
    .cfdi-field {
        display: flex;
        flex-direction: column;
        gap: 3px;
    }
    .cfdi-label {
        font-size: 10.5px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #6c757d;
    }
    .cfdi-value {
        font-size: 13px;
        color: var(--color-dark);
        font-weight: 500;
        word-break: break-word;
    }
    .cfdi-value.mono {
        font-family: monospace;
        font-size: 12px;
    }
    .cfdi-value.na {
        color: #adb5bd;
        font-weight: 400;
    }
    @@media (max-width: 768px) {
        .cfdi-fields { grid-template-columns: 1fr 1fr; }
    }
    .cfdi-full-card {
        margin-top: 0;
    }
    /* ── Sellos card ─────────────────────────────────────────── */
    .sello-block {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }
    .sello-label {
        font-size: 10.5px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #6c757d;
    }
    .sello-value {
        font-family: 'Consolas', 'Monaco', monospace;
        font-size: 11.5px;
        color: var(--color-dark);
        background: var(--bg-light-subtle);
        border: 1px solid rgba(0,0,0,0.07);
        border-radius: 8px;
        padding: 8px 10px;
        word-break: break-all;
        line-height: 1.5;
        max-height: 80px;
        overflow-y: auto;
        white-space: pre-wrap;
    }
    .sello-copy-btn {
        align-self: flex-end;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 11px;
        font-weight: 600;
        color: var(--color-primary);
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 2px 4px;
        border-radius: 4px;
        transition: opacity 0.15s;
    }
    .sello-copy-btn:hover { opacity: 0.7; }
    .sellos-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }
    .sellos-grid .sello-block.full-width {
        grid-column: 1 / -1;
    }
    @@media (max-width: 768px) {
        .sellos-grid { grid-template-columns: 1fr; }
    }
    /* ── Dark mode overrides ─────────────────────────────────── */
    [data-theme="dark"] .cfdi-section-title {
        color: #9090b0;
        border-bottom-color: rgba(255, 255, 255, 0.07);
    }
    [data-theme="dark"] .cfdi-label {
        color: #9090b0;
    }
    [data-theme="dark"] .cfdi-value {
        color: #e0e0f0;
    }
    [data-theme="dark"] .cfdi-value.na {
        color: #55556a;
    }
    [data-theme="dark"] .sello-label {
        color: #9090b0;
    }
    [data-theme="dark"] .sello-value {
        color: #e0e0f0;
        background: var(--bg-dark-subtle);
        border-color: rgba(255,255,255,0.07);
    }
</style>

<div class="errores-page">

    <!-- ── Header card ── -->
    <div class="td-header-card">
        <div class="td-header-top">
            <span class="tb-badge-top">
                <i class="bi bi-receipt-cutoff"></i> Timbrado
            </span>
            <div class="td-header-actions">
                @if (Model.Cancelada)
                {
                    <span class="tb-pill tb-pill-cancel">
                        <i class="bi bi-x-circle-fill"></i> Cancelada
                    </span>
                }
                else
                {
                    <span class="tb-pill tb-pill-ok">
                        <i class="bi bi-check-circle-fill"></i> Vigente
                    </span>
                }
                @if (!string.IsNullOrWhiteSpace(Model.XmlTimbrado))
                {
                    <a href="@Url.Action("DescargarPdf", "Timbrados", new { id = Model.Id })"
                       class="vg-btn vg-btn-primary"
                       title="Descargar representación impresa del CFDI en PDF"
                       target="_blank">
                        <i class="bi bi-file-earmark-pdf"></i> Descargar PDF
                    </a>
                }
                <a href="@Url.Action("Index", "Timbrados")" class="vg-btn vg-btn-outline">
                    <i class="bi bi-arrow-left"></i> Volver al índice
                </a>
            </div>
        </div>

        <div class="td-header-body">
            <div class="td-header-info">
                <h1 class="errores-title">Detalle del Timbrado #@Model.Id</h1>
                <div class="ed-header-meta">
                    <span class="ec-time">
                        <i class="bi bi-clock"></i>
                        @Model.CreatedUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC
                    </span>
                    <span class="tb-pill tb-pill-mid">
                        <i class="bi bi-people"></i> Tenant: @Model.TenantId
                    </span>
                    @if (Model.Saldo.HasValue)
                    {
                        <span class="tb-pill tb-pill-mid">
                            <i class="bi bi-cash-coin"></i> Saldo: @Model.Saldo.Value.ToString("N2")
                        </span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ── Tarjeta grande: datos del comprobante ── -->
    <div class="errores-ring-card cfdi-full-card">

        <!-- EMISOR ──────────────────────────────────── -->
        <div class="cfdi-section">
            <p class="cfdi-section-title"><i class="bi bi-building"></i> Emisor</p>
            <div class="cfdi-fields">
                <div class="cfdi-field">
                    <span class="cfdi-label">RFC Emisor</span>
                    <span class="cfdi-value mono">@V(Model.RfcEmisor)</span>
                </div>
                <div class="cfdi-field">
                    <span class="cfdi-label">Nombre Emisor</span>
                    <span class="cfdi-value @(string.IsNullOrWhiteSpace(Model.NombreEmisor) ? "na" : "")">@V(Model.NombreEmisor)</span>
                </div>
                <div class="cfdi-field">
                    <span class="cfdi-label">Régimen Fiscal</span>
                    <span class="cfdi-value @(string.IsNullOrWhiteSpace(Model.RegimenFiscalEmisor) ? "na" : "")">@V(Model.RegimenFiscalEmisor)</span>
                </div>
                <div class="cfdi-field">
                    <span class="cfdi-label">Lugar Expedición</span>
                    <span class="cfdi-value @(string.IsNullOrWhiteSpace(Model.LugarExpedicion) ? "na" : "")">@V(Model.LugarExpedicion)</span>
                </div>
            </div>
        </div>

        <div class="ed-divider" style="margin:14px 0;"></div>

        <!-- RECEPTOR ────────────────────────────────── -->
        <div class="cfdi-section">
            <p class="cfdi-section-title"><i class="bi bi-person-badge"></i> Receptor</p>
            <div class="cfdi-fields">
                <div class="cfdi-field">
                    <span class="cfdi-label">RFC Receptor</span>
                    <span class="cfdi-value mono">@V(Model.RfcReceptor)</span>
                </div>
                <div class="cfdi-field">
                    <span class="cfdi-label">Nombre Receptor</span>
                    <span class="cfdi-value @(string.IsNullOrWhiteSpace(Model.NombreReceptor) ? "na" : "")">@V(Model.NombreReceptor)</span>
                </div>
                <div class="cfdi-field">
                    <span class="cfdi-label">Uso CFDI</span>
                    <span class="cfdi-value @(string.IsNullOrWhiteSpace(Model.UsoCFDI) ? "na" : "")">@V(Model.UsoCFDI)</span>
                </div>
                <div class="cfdi-field">
                    <span class="cfdi-label">Domicilio Fiscal</span>
                    <span class="cfdi-value @(string.IsNullOrWhiteSpace(Model.DomicilioFiscalReceptor) ? "na" : "")">@V(Model.DomicilioFiscalReceptor)</span>
                </div>
                <div class="cfdi-field">
                    <span class="cfdi-label">Régimen Fiscal Receptor</span>
                    <span class="cfdi-value @(string.IsNullOrWhiteSpace(Model.RegimenFiscalReceptor) ? "na" : "")">@V(Model.RegimenFiscalReceptor)</span>
                </div>
            </div>
        </div>

        <div class="ed-divider" style="margin:14px 0;"></div>

        <!-- COMPROBANTE ─────────────────────────────── -->
        <div class="cfdi-section">
            <p class="cfdi-section-title"><i class="bi bi-receipt"></i> Comprobante</p>
            <div class="cfdi-fields">
                <div class="cfdi-field">
                    <span class="cfdi-label">Tipo de Comprobante</span>
                    @if (!string.IsNullOrWhiteSpace(Model.TipoDeComprobante))
                    {
                        <span class="tb-pill tb-pill-ok" style="width:fit-content;font-size:11px;">
                            <i class="bi bi-file-earmark-check"></i> @Model.TipoDeComprobante
                        </span>
                    }
                    else
                    {
                        <span class="cfdi-value na">—</span>
                    }
                </div>
                <div class="cfdi-field">
                    <span class="cfdi-label">Origen</span>
                    <span class="cfdi-value @(string.IsNullOrWhiteSpace(Model.Origen) ? "na" : "")">@V(Model.Origen)</span>
                </div>
                <div class="cfdi-field">
                    <span class="cfdi-label">Serie</span>
                    <span class="cfdi-value @(string.IsNullOrWhiteSpace(Model.Serie) ? "na" : "")">@V(Model.Serie)</span>
                </div>
                <div class="cfdi-field">
                    <span class="cfdi-label">Folio</span>
                    <span class="cfdi-value @(string.IsNullOrWhiteSpace(Model.Folio) ? "na" : "")">@V(Model.Folio)</span>
                </div>
                <div class="cfdi-field" style="grid-column: span 2;">
                    <span class="cfdi-label">UUID</span>
                    <span class="cfdi-value mono" style="font-size:12px;">@V(Model.Uuid)</span>
                </div>
                <div class="cfdi-field">
                    <span class="cfdi-label">Fecha Emisión</span>
                    <span class="cfdi-value @(string.IsNullOrWhiteSpace(Model.Fecha) ? "na" : "")">@V(Model.Fecha)</span>
                </div>
                <div class="cfdi-field">
                    <span class="cfdi-label">Fecha Timbrado</span>
                    <span class="cfdi-value @(string.IsNullOrWhiteSpace(Model.FechaTimbrado) ? "na" : "")">@V(Model.FechaTimbrado)</span>
                </div>
                <div class="cfdi-field">
                    <span class="cfdi-label">Subtotal</span>
                    <span class="cfdi-value @(string.IsNullOrWhiteSpace(Model.Subtotal) ? "na" : "")">@V(Model.Subtotal)</span>
                </div>
                <div class="cfdi-field">
                    <span class="cfdi-label">Total</span>
                    <span class="cfdi-value @(string.IsNullOrWhiteSpace(Model.Total) ? "na" : "")">@V(Model.Total)</span>
                </div>
                <div class="cfdi-field">
                    <span class="cfdi-label">Moneda</span>
                    <span class="cfdi-value @(string.IsNullOrWhiteSpace(Model.Moneda) ? "na" : "")">@V(Model.Moneda)</span>
                </div>
                <div class="cfdi-field">
                    <span class="cfdi-label">Tipo de Cambio</span>
                    <span class="cfdi-value @(string.IsNullOrWhiteSpace(Model.TipoCambio) ? "na" : "")">@V(Model.TipoCambio)</span>
                </div>
                <div class="cfdi-field">
                    <span class="cfdi-label">Forma de Pago</span>
                    <span class="cfdi-value @(string.IsNullOrWhiteSpace(Model.FormaPago) ? "na" : "")">@V(Model.FormaPago)</span>
                </div>
                <div class="cfdi-field">
                    <span class="cfdi-label">Método de Pago</span>
                    <span class="cfdi-value @(string.IsNullOrWhiteSpace(Model.MetodoPago) ? "na" : "")">@V(Model.MetodoPago)</span>
                </div>
                <div class="cfdi-field">
                    <span class="cfdi-label">Condiciones de Pago</span>
                    <span class="cfdi-value @(string.IsNullOrWhiteSpace(Model.CondicionesDePago) ? "na" : "")">@V(Model.CondicionesDePago)</span>
                </div>
                <div class="cfdi-field">
                    <span class="cfdi-label">No. Certificado</span>
                    <span class="cfdi-value mono @(string.IsNullOrWhiteSpace(Model.NoCertificado) ? "na" : "")">@V(Model.NoCertificado)</span>
                </div>
                <div class="cfdi-field">
                    <span class="cfdi-label">No. Certificado SAT</span>
                    <span class="cfdi-value mono @(string.IsNullOrWhiteSpace(Model.NoCertificadoSAT) ? "na" : "")">@V(Model.NoCertificadoSAT)</span>
                </div>
            </div>
        </div>

    </div>

    <!-- ── Tarjeta: Sellos y cadena original ── -->
    <div class="errores-ring-card cfdi-full-card">

        <div class="cfdi-section" style="margin-top:0;">
            <p class="cfdi-section-title"><i class="bi bi-shield-lock"></i> Sellos &amp; Cadena Original</p>
        </div>

        <!-- Números de certificado (compactos, en grid normal) -->
        <div class="cfdi-fields" style="margin-bottom:14px;">
            <div class="cfdi-field">
                <span class="cfdi-label">No. Certificado (emisor)</span>
                <span class="cfdi-value mono @(string.IsNullOrWhiteSpace(Model.NoCertificado) ? "na" : "")">@V(Model.NoCertificado)</span>
            </div>
            <div class="cfdi-field">
                <span class="cfdi-label">No. Certificado SAT</span>
                <span class="cfdi-value mono @(string.IsNullOrWhiteSpace(Model.NoCertificadoSAT) ? "na" : "")">@V(Model.NoCertificadoSAT)</span>
            </div>
        </div>

        <div class="ed-divider" style="margin:0 0 14px 0;"></div>

        <!-- Cadena original, SelloSAT, SelloCFD, Certificado -->
        <div class="sellos-grid">

            @if (!string.IsNullOrWhiteSpace(Model.CadenaOriginalTFD))
            {
                <div class="sello-block full-width">
                    <div style="display:flex;justify-content:space-between;align-items:center;">
                        <span class="sello-label"><i class="bi bi-link-45deg"></i> Cadena Original TFD</span>
                        <button class="sello-copy-btn" onclick="copiarTexto(this, 'cadena-tfd')">
                            <i class="bi bi-clipboard"></i> Copiar
                        </button>
                    </div>
                    <div class="sello-value" id="cadena-tfd">@Model.CadenaOriginalTFD</div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.SelloSAT))
            {
                <div class="sello-block full-width">
                    <div style="display:flex;justify-content:space-between;align-items:center;">
                        <span class="sello-label"><i class="bi bi-patch-check-fill"></i> Sello SAT</span>
                        <button class="sello-copy-btn" onclick="copiarTexto(this, 'sello-sat')">
                            <i class="bi bi-clipboard"></i> Copiar
                        </button>
                    </div>
                    <div class="sello-value" id="sello-sat">@Model.SelloSAT</div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.SelloCFD))
            {
                <div class="sello-block full-width">
                    <div style="display:flex;justify-content:space-between;align-items:center;">
                        <span class="sello-label"><i class="bi bi-pen-fill"></i> Sello CFD (emisor)</span>
                        <button class="sello-copy-btn" onclick="copiarTexto(this, 'sello-cfd')">
                            <i class="bi bi-clipboard"></i> Copiar
                        </button>
                    </div>
                    <div class="sello-value" id="sello-cfd">@Model.SelloCFD</div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Certificado))
            {
                <div class="sello-block full-width">
                    <div style="display:flex;justify-content:space-between;align-items:center;">
                        <span class="sello-label"><i class="bi bi-file-earmark-lock2"></i> Certificado (base64)</span>
                        <button class="sello-copy-btn" onclick="copiarTexto(this, 'certificado-b64')">
                            <i class="bi bi-clipboard"></i> Copiar
                        </button>
                    </div>
                    <div class="sello-value" id="certificado-b64">@Model.Certificado</div>
                </div>
            }

        </div>

    </div>

    <!-- ── XML Viewer ── -->
    <div class="ed-json-card" style="margin-top:16px;">

        <div class="ed-json-header">
            <div>
                <h4 class="ed-json-title">
                    <i class="bi bi-code-slash"></i> XML Timbrado
                </h4>
                <span class="ed-json-sub">Contenido XML completo del CFDI timbrado</span>
            </div>
            <span class="ed-json-badge ed-json-valid">XML</span>
        </div>

        <div class="ed-json-toolbar">
            <button class="ed-tool-btn" onclick="copiarXML()">
                <i class="bi bi-clipboard"></i> Copiar XML
            </button>
            <button class="ed-tool-btn" onclick="descargarXML()">
                <i class="bi bi-download"></i> Descargar
            </button>
            <button class="ed-tool-btn" onclick="formatearXML()">
                <i class="bi bi-arrow-clockwise"></i> Re-formatear
            </button>
            <span class="ed-json-size">
                Tamaño: <strong id="xmlSize">0</strong> caracteres
            </span>
        </div>

        <div class="ed-json-content" id="xmlViewer">
            @if (!string.IsNullOrWhiteSpace(Model.XmlTimbrado))
            {
                <pre id="xmlContent">@Html.Raw(System.Net.WebUtility.HtmlEncode(Model.XmlTimbrado))</pre>
            }
            else
            {
                <div class="ed-json-empty">
                    <i class="bi bi-file-earmark-x ed-empty-icon"></i>
                    <h5>No hay XML disponible</h5>
                    <p>No se encontró contenido XML para este timbrado.</p>
                </div>
            }
        </div>

    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const el = document.getElementById('xmlContent');
            if (!el) return;
            const raw = el.textContent || el.innerText || '';
            renderXmlInViewer(raw);
        });

        function mostrarNotificacion(mensaje, tipo = 'success') {
            const div = document.createElement('div');
            div.style.cssText = `position:fixed;bottom:24px;right:24px;z-index:9999;
                background:${tipo === 'success' ? '#11998e' : '#ff416c'};color:white;
                padding:12px 20px;border-radius:12px;font-size:14px;
                box-shadow:0 8px 24px rgba(0,0,0,0.2);display:flex;align-items:center;gap:8px;`;
            div.innerHTML = `<i class="bi bi-${tipo === 'success' ? 'check-circle' : 'exclamation-circle'}"></i> ${mensaje}`;
            document.body.appendChild(div);
            setTimeout(() => div.remove(), 3000);
        }

        async function copiarTexto(btn, elementId) {
            const el = document.getElementById(elementId);
            if (!el) return;
            try {
                await navigator.clipboard.writeText(el.innerText.trim());
                const orig = btn.innerHTML;
                btn.innerHTML = '<i class="bi bi-check2"></i> Copiado';
                setTimeout(() => btn.innerHTML = orig, 2000);
            } catch {
                mostrarNotificacion('Error al copiar', 'error');
            }
        }

        async function copiarXML() {
            try {
                const response = await fetch('@Url.Action("GetXmlFormatted", "Timbrados")?id=@Model.Id');
                const data = await response.json();
                if (data.success && data.xmlFormatted) {
                    await navigator.clipboard.writeText(data.xmlFormatted);
                    mostrarNotificacion('XML copiado al portapapeles');
                } else {
                    const raw = document.getElementById('xmlContent')?.innerText ?? '';
                    await navigator.clipboard.writeText(raw);
                    mostrarNotificacion('XML copiado (crudo)');
                }
            } catch (error) {
                mostrarNotificacion('Error al copiar: ' + error.message, 'error');
            }
        }

        function descargarXML() {
            const xmlContent = document.getElementById('xmlContent')?.innerText ?? '';
            if (!xmlContent.trim()) {
                mostrarNotificacion('No hay XML para descargar', 'error');
                return;
            }
            const blob = new Blob([xmlContent], { type: 'application/xml' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = "@fileNameXml";
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        }

        async function formatearXML() {
            try {
                const response = await fetch('@Url.Action("GetXmlFormatted", "Timbrados")?id=@Model.Id');
                const data = await response.json();
                if (data.success && data.xmlFormatted) {
                    const viewer = document.getElementById('xmlViewer');
                    viewer.innerHTML = `<pre id="xmlContent"></pre>`;
                    renderXmlInViewer(data.xmlFormatted);
                    mostrarNotificacion('XML formateado correctamente');
                } else {
                    mostrarNotificacion('No se pudo formatear XML', 'error');
                }
            } catch (error) {
                mostrarNotificacion('Error: ' + error.message, 'error');
            }
        }

        function highlightXml(xml) {
            if (!xml) return '';
            xml = xml.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
            xml = xml.replace(/(&lt;!--[\s\S]*?--&gt;)/g, '<span class="xml-comment">$1</span>');
            xml = xml.replace(/(&lt;\/?)([\w:.-]+)([^&]*?)(\/?&gt;)/g,
                function (m, p1, tag, attrs, p4) {
                    attrs = attrs.replace(/([\w:.-]+)=(".*?")/g,
                        '<span class="xml-attr-name">$1</span>=<span class="xml-attr-val">$2</span>');
                    return '<span class="xml-punct">&lt;</span>'
                        + '<span class="xml-tag">' + tag + '</span>'
                        + attrs
                        + '<span class="xml-punct">' + p4.replace('&gt;', '&gt;') + '</span>';
                });
            return xml;
        }

        function renderXmlInViewer(xmlText) {
            const pre = document.getElementById('xmlContent');
            if (!pre) return;
            pre.innerHTML = highlightXml(xmlText);
            const sizeEl = document.getElementById('xmlSize');
            if (sizeEl) sizeEl.textContent = (xmlText?.length || 0).toLocaleString();
        }
    </script>
}
